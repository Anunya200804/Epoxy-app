                </div>
                <div>
                    <p>ผู้รับเงิน / เจ้าหน้าที่การเงิน</p>
                    <div class="signature-line">
                        ลงชื่อ......................................................<br />
                        วันที่ ......./......./.......
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal for Payment Confirmation before Receipt Issuance -->
@if (isPaymentConfirmModalOpen && projectToConfirmPayment != null)
{
    <div class="modal-overlay no-print" style="z-index: 1150;">
        <div class="modal-content-custom" style="max-width: 550px; background: #ffffff; border-radius: 14px; box-shadow: 0 20px 40px rgba(0,0,0,0.25); border: none; overflow: hidden; color: #1e293b;">
            <!-- Modal Header -->
            <div class="modal-header-custom" style="background: linear-gradient(135deg, #059669, #10b981); color: white; padding: 18px 24px; display: flex; justify-content: space-between; align-items: center;">
                <h3 style="color: white; margin: 0; font-size: 1.15rem; font-weight: 700; display: flex; align-items: center; gap: 8px;">
                    <i class="bi bi-wallet2"></i> บันทึกรับชำระเงินงวดสุดท้าย
                </h3>
                <button class="modal-close-btn" style="color: white; background: rgba(255,255,255,0.2);" @onclick="ClosePaymentConfirmModal">&times;</button>
            </div>

            <div class="modal-body-custom" style="padding: 24px; max-height: 75vh; overflow-y: auto; background: #ffffff;">
                <!-- Due Date & Overdue Status Alert -->
                @if (projectToConfirmPayment.OverdueDays > 0)
                {
                    <div style="background: #fff1f2; border: 1.5px solid #fca5a5; border-radius: 8px; padding: 12px 14px; margin-bottom: 16px; color: #991b1b;">
                        <div style="font-weight: 700; font-size: 0.95rem; display: flex; align-items: center; gap: 6px;">
                            <i class="bi bi-exclamation-triangle-fill text-danger"></i> ชำระเกินกำหนดเวลา 7 วัน (ล่าช้า @projectToConfirmPayment.OverdueDays วัน)
                        </div>
                        <div style="font-size: 0.85rem; margin-top: 4px; color: #b91c1c; line-height: 1.5;">
                            วันครบกำหนดคือ: <strong>@projectToConfirmPayment.DueDate?.ToString("dd MMMM yyyy")</strong><br />
                            คิดค่าปรับชำระล่าช้า 3% ต่อวัน (จากยอดคงเหลือ): <strong style="font-size: 0.95rem;">+ ฿@projectToConfirmPayment.LatePenaltyAmount.ToString("N0")</strong>
                        </div>
                    </div>
                }
                else
                {
                    <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; padding: 10px 14px; margin-bottom: 16px; color: #166534; font-size: 0.85rem; display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <i class="bi bi-shield-check text-success me-1"></i> อยู่ในกำหนดเวลาชำระเงิน (ครบกำหนด: <strong>@projectToConfirmPayment.DueDate?.ToString("dd MMMM yyyy")</strong>)
                        </div>
                        <span class="badge bg-success" style="font-size: 0.75rem;">เหลืออีก @projectToConfirmPayment.DaysRemaining วัน</span>
                    </div>
                }

                <!-- Project Summary Card -->
                <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 16px; margin-bottom: 18px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                        <span style="font-size: 0.85rem; color: #64748b;">รหัสโครงการ:</span>
                        <strong style="color: var(--primary); font-size: 0.95rem;">PROJ-@projectToConfirmPayment.Id (QT-@projectToConfirmPayment.QuotationId)</strong>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px;">
                        <span style="font-size: 0.85rem; color: #64748b;">ลูกค้า:</span>
                        <strong style="color: #0f172a; text-align: right;">@projectToConfirmPayment.Quotation?.Customer?.Name</strong>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px;">
                        <span style="font-size: 0.85rem; color: #64748b;">วันที่ส่งมอบงานเสร็จ:</span>
                        <span style="color: #0f172a; font-weight: 600; font-size: 0.85rem;">@projectToConfirmPayment.EndDate?.ToString("dd MMMM yyyy")</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
                        <span style="font-size: 0.85rem; color: #64748b;">ลักษณะงาน:</span>
                        <span style="color: #334155; font-size: 0.85rem; text-align: right; max-width: 60%;">@projectToConfirmPayment.Quotation?.JobDescription</span>
                    </div>

                    <div style="border-top: 1px dashed #cbd5e1; padding-top: 10px; margin-top: 6px; display: flex; flex-direction: column; gap: 6px;">
                        <div style="display: flex; justify-content: space-between; font-size: 0.88rem; color: #475569;">
                            <span>ราคารวมโครงการทั้งสิ้น:</span>
                            <strong style="color: #0f172a;">฿@projectToConfirmPayment.Quotation?.TotalPrice.ToString("N0")</strong>
                        </div>
                        <div style="display: flex; justify-content: space-between; font-size: 0.88rem; color: #059669;">
                            <span>หักเงินมัดจำ (ชำระแล้ว):</span>
                            <span>- ฿@projectToConfirmPayment.Quotation?.DepositAmount.ToString("N0")</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; font-size: 0.95rem; color: #0f172a; font-weight: 600;">
                            <span>ยอดเงินงวดสุดท้ายคงเหลือ:</span>
                            <span>฿@projectToConfirmPayment.Quotation?.BalanceAmount.ToString("N0")</span>
                        </div>
                        @if (projectToConfirmPayment.OverdueDays > 0)
                        {
                            <div style="display: flex; justify-content: space-between; font-size: 0.92rem; color: #dc2626; font-weight: 700; background: #fee2e2; padding: 4px 8px; border-radius: 4px;">
                                <span>ค่าปรับล่าช้า (@projectToConfirmPayment.OverdueDays วัน × 3%/วัน):</span>
                                <span>+ ฿@projectToConfirmPayment.LatePenaltyAmount.ToString("N0")</span>
                            </div>
                        }
                        <div style="display: flex; justify-content: space-between; font-size: 1.15rem; font-weight: 800; color: @(projectToConfirmPayment.OverdueDays > 0 ? "#dc2626" : "#16a34a"); padding-top: 8px; border-top: 1px solid #e2e8f0; margin-top: 4px;">
                            <span>ยอดรวมรับชำระสุทธิ:</span>
                            <span>฿@projectToConfirmPayment.TotalPayableAmount.ToString("N0")</span>
                        </div>
                    </div>
                </div>

                <!-- Slip Upload Box -->
                <div class="form-group mb-3">
                    <label class="form-label" style="font-weight: 600; color: #0f172a; display: flex; align-items: center; gap: 6px; font-size: 0.88rem;">
                        <i class="bi bi-receipt text-success"></i> แนบรูปภาพสลิปโอนเงินงวดสุดท้าย
                    </label>
                    <div style="border: 2px dashed #94a3b8; border-radius: 8px; padding: 16px; text-align: center; background: #f8fafc;">
                        <InputFile OnChange="OnFinalPaymentSlipSelected" accept="image/*" class="form-control" id="final-pay-slip-file" style="display: none;" />
                        <label for="final-pay-slip-file" class="btn btn-outline-primary btn-sm mb-0" style="cursor: pointer; padding: 7px 18px; font-weight: 600; font-size: 0.85rem; border-radius: 6px;">
                            <i class="bi bi-cloud-arrow-up-fill me-1"></i> เลือกรูปภาพสลิป
                        </label>
                        <div class="text-muted mt-2" style="font-size: 0.75rem;">รองรับไฟล์รูปภาพ JPG, PNG, WebP</div>
                    </div>

                    @if (!string.IsNullOrEmpty(finalPaymentSlipDataUrl))
                    {
                        <div class="mt-3 text-center" style="background: #f1f5f9; padding: 12px; border-radius: 8px; border: 1px solid #cbd5e1;">
                            <img src="@finalPaymentSlipDataUrl" alt="Slip" style="max-height: 200px; max-width: 100%; border-radius: 6px; box-shadow: 0 2px 8px rgba(0,0,0,0.12); cursor: pointer;" 
                                 title="คลิกดูภาพขยาย"
                                 @onclick="@(() => OpenImageLightbox(finalPaymentSlipDataUrl, "สลิปโอนเงินงวดสุดท้าย"))" />
                            <div class="mt-2">
                                <button type="button" class="btn btn-sm btn-outline-danger" style="font-size: 0.78rem; padding: 3px 12px;" @onclick="() => finalPaymentSlipDataUrl = null">
                                    <i class="bi bi-trash me-1"></i> ลบรูปสลิป
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <!-- Note Input -->
                <div class="form-group mb-3">
                    <label class="form-label" style="font-size: 0.85rem; font-weight: 600; color: #0f172a;">หมายเหตุการชำระเงิน / เลขที่อ้างอิง</label>
                    <input type="text" class="form-control-custom" @bind="finalPaymentNote" placeholder="เช่น โอนเข้า บช. กสิกรไทย เวลา 15:45 น." />
                </div>

                <!-- Confirmation Checkbox Box -->
                <div style="background: #f0fdf4; border: 1px solid #86efac; border-radius: 8px; padding: 14px; display: flex; gap: 12px; align-items: flex-start;">
                    <input type="checkbox" id="confirm-payment-chk" @bind="hasConfirmedFinalPaymentCheckbox" style="width: 22px; height: 22px; cursor: pointer; margin-top: 2px; accent-color: #16a34a;" />
                    <label for="confirm-payment-chk" style="font-size: 0.85rem; cursor: pointer; user-select: none; color: #166534; font-weight: 600; line-height: 1.5;">
                        ขอยืนยันว่าได้รับการชำระเงินงวดสุดท้าย จำนวน ฿@projectToConfirmPayment.TotalPayableAmount.ToString("N0") @(projectToConfirmPayment.OverdueDays > 0 ? "(รวมค่าปรับชำระล่าช้า)" : "") เรียบร้อยแล้วจริง และขอเปิดสิทธิ์ให้ออกใบเสร็จรับเงิน
                    </label>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer-custom" style="padding: 14px 24px; background: #f8fafc; border-top: 1px solid #e2e8f0; display: flex; justify-content: flex-end; gap: 12px;">
                <button type="button" class="btn-custom btn-secondary-custom" @onclick="ClosePaymentConfirmModal">ยกเลิก</button>
                <button type="button" class="btn-custom btn-primary-custom" style="background: linear-gradient(135deg, #059669, #10b981); color: white; font-weight: 600; padding: 8px 20px;" 
                        disabled="@(!hasConfirmedFinalPaymentCheckbox)" @onclick="ConfirmFinalPaymentSave">
                    <i class="bi bi-check2-circle me-1"></i> ยืนยันการชำระเงิน & เปิดสิทธิ์ใบเสร็จ
                </button>
            </div>
        </div>
    </div>
}

<!-- Lightbox Modal for Images -->
@if (isLightboxOpen && !string.IsNullOrEmpty(lightboxImageUrl))
{
    <div class="modal-overlay no-print" style="z-index: 1300;" @onclick="CloseImageLightbox">
        <div class="modal-content-custom" style="max-width: 750px; width: 95%; background: #0f172a; border: 1px solid rgba(255,255,255,0.1);" @onclick:stopPropagation="true">
