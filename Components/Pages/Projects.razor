@page "/projects"
@inject EpoxyDbContext Db
@inject AuthService AuthService
@inject IJSRuntime JS

<PageTitle>ติดตามงานติดตั้ง - ระบบการจัดการพื้น Epoxy</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4 no-print flex-wrap gap-2">
    <div>
        <h2 class="mb-1" style="font-weight: 700; color: var(--primary);">กระบวนการติดตั้งและติดตามชำระเงิน</h2>
        <p class="text-muted mb-0">ติดตามความคืบหน้าหน้างาน กำหนดชำระงวดสุดท้ายภายใน 7 วัน และคำนวณค่าปรับชำระล่าช้า 3%/วัน แบบเรียลไทม์</p>
    </div>
</div>

<!-- KPI Summary Cards -->
<div class="row g-3 mb-4 no-print" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px;">
    <!-- 1. Total Projects -->
    <div style="background: white; border-radius: 12px; padding: 18px; border: 1px solid #e2e8f0; box-shadow: 0 2px 8px rgba(0,0,0,0.04); display: flex; align-items: center; gap: 14px;">
        <div style="width: 48px; height: 48px; border-radius: 10px; background: rgba(59,130,246,0.1); color: #2563eb; display: flex; align-items: center; justify-content: center; font-size: 1.4rem;">
            <i class="bi bi-kanban"></i>
        </div>
        <div>
            <div style="font-size: 0.82rem; color: #64748b; font-weight: 600;">โครงการทั้งหมด</div>
            <div style="font-size: 1.4rem; font-weight: 800; color: #0f172a;">@projects.Count โครงการ</div>
        </div>
    </div>

    <!-- 2. In Progress -->
    <div style="background: white; border-radius: 12px; padding: 18px; border: 1px solid #e2e8f0; box-shadow: 0 2px 8px rgba(0,0,0,0.04); display: flex; align-items: center; gap: 14px;">
        <div style="width: 48px; height: 48px; border-radius: 10px; background: rgba(245,158,11,0.1); color: #d97706; display: flex; align-items: center; justify-content: center; font-size: 1.4rem;">
            <i class="bi bi-hourglass-split"></i>
        </div>
        <div>
            <div style="font-size: 0.82rem; color: #64748b; font-weight: 600;">กำลังดำเนินการ</div>
            <div style="font-size: 1.4rem; font-weight: 800; color: #d97706;">@projects.Count(p => p.StepStatus != InstallationStep.Completed) งาน</div>
        </div>
    </div>

    <!-- 3. Completed & Paid -->
    <div style="background: white; border-radius: 12px; padding: 18px; border: 1px solid #e2e8f0; box-shadow: 0 2px 8px rgba(0,0,0,0.04); display: flex; align-items: center; gap: 14px;">
        <div style="width: 48px; height: 48px; border-radius: 10px; background: rgba(16,185,129,0.1); color: #059669; display: flex; align-items: center; justify-content: center; font-size: 1.4rem;">
            <i class="bi bi-check2-circle"></i>
        </div>
        <div>
            <div style="font-size: 0.82rem; color: #64748b; font-weight: 600;">ชำระเงินครบถ้วน</div>
            <div style="font-size: 1.4rem; font-weight: 800; color: #059669;">@projects.Count(p => p.PaymentStatus == PaymentStatus.Paid) งาน</div>
        </div>
    </div>

    <!-- 4. Overdue with 3% Penalty -->
    @{
        var overdueProjects = projects.Where(p => p.PaymentStatus == PaymentStatus.Pending && p.OverdueDays > 0).ToList();
        var totalPenalty = overdueProjects.Sum(p => p.LatePenaltyAmount);
    }
    <div style="background: @(overdueProjects.Any() ? "#fff1f2" : "white"); border-radius: 12px; padding: 18px; border: 1px solid @(overdueProjects.Any() ? "#fecdd3" : "#e2e8f0"); box-shadow: 0 2px 8px rgba(0,0,0,0.04); display: flex; align-items: center; gap: 14px;">
        <div style="width: 48px; height: 48px; border-radius: 10px; background: rgba(239,68,68,0.12); color: #dc2626; display: flex; align-items: center; justify-content: center; font-size: 1.4rem;">
            <i class="bi bi-exclamation-octagon-fill"></i>
        </div>
        <div>
            <div style="font-size: 0.82rem; color: #991b1b; font-weight: 600;">เกินกำหนดชำระ 7 วัน</div>
            <div style="font-size: 1.4rem; font-weight: 800; color: #dc2626;">
                @overdueProjects.Count งาน
                @if (totalPenalty > 0)
                {
                    <span style="font-size: 0.75rem; font-weight: 600; color: #b91c1c; display: block;">(+ค่าปรับรวม ฿@totalPenalty.ToString("N0"))</span>
                }
            </div>
        </div>
    </div>
</div>

<!-- Project List -->
<div class="card-panel no-print">
    <div class="custom-table-container">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>เลขที่โครงการ</th>
                    <th>ลูกค้า</th>
                    <th>ทีมช่างผู้รับผิดชอบ</th>
                    <th>ขั้นตอนการทำงาน</th>
                    <th>วันที่ดำเนินงาน</th>
                    <th>กำหนดชำระเงินงวดสุดท้าย</th>
                    <th>ยอดเรียกเก็บงวดสุดท้าย</th>
                    <th class="text-center">จัดการ</th>
                </tr>
            </thead>
            <tbody>
                @if (projects.Any())
                {
                    @foreach (var p in projects)
                    {
                        <tr>
                            <td><strong>PROJ-@p.Id (QT-@p.QuotationId)</strong></td>
                            <td>
                                <strong>@p.Quotation?.Customer?.Name</strong><br />
                                <span style="font-size: 0.8rem; color: #aaa;">@p.Quotation?.JobDescription</span>
                            </td>
                            <td>
                                @if (p.TechnicianTeam != null)
                                {
                                    <span>@p.TechnicianTeam.TeamName (หัวหน้า: @p.TechnicianTeam.LeaderName)</span>
                                }
                                else
                                {
                                    <span class="text-danger"><i class="bi bi-exclamation-triangle"></i> ยังไม่ได้ระบุทีม</span>
                                }
                            </td>
                            <td>
                                <span class="badge-status badge-@GetStepBadgeClass(p.StepStatus)">
                                    @GetStepName(p.StepStatus)
                                </span>
                            </td>
                            <td>
                                <div style="font-size: 0.82rem;">
                                    <div><strong>เริ่ม:</strong> @p.StartDate.ToString("dd/MM/yyyy")</div>
                                    @if (p.EndDate.HasValue)
                                    {
                                        <div style="color: #16a34a;"><strong>เสร็จ:</strong> @p.EndDate.Value.ToString("dd/MM/yyyy")</div>
                                    }
                                </div>
                            </td>
                            <td>
                                @if (p.PaymentStatus == PaymentStatus.Paid)
                                {
                                    <div style="font-size: 0.82rem;">
                                        <span class="badge bg-success" style="padding: 4px 8px; font-weight: 600;">
                                            <i class="bi bi-check-circle-fill me-1"></i> ชำระครบแล้ว
                                        </span>
                                        @if (p.PaymentDate.HasValue)
                                        {
                                            <div class="text-muted" style="font-size: 0.75rem; margin-top: 2px;">
                                                เมื่อ @p.PaymentDate.Value.ToString("dd/MM/yyyy")
                                            </div>
                                        }
                                        @if (p.OverdueDays > 0)
                                        {
                                            <div style="color: #ea580c; font-size: 0.72rem;">(จ่ายล่าช้า @p.OverdueDays วัน)</div>
                                        }
                                    </div>
                                }
                                else if (p.EndDate.HasValue)
                                {
                                    @if (p.OverdueDays <= 0)
                                    {
                                        <div>
                                            <span class="badge" style="background: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd; font-size: 0.8rem; padding: 4px 8px;">
                                                <i class="bi bi-clock-history me-1"></i> ภายใน @p.DueDate?.ToString("dd/MM/yyyy")
                                            </span>
                                            <div style="font-size: 0.75rem; color: #0284c7; margin-top: 3px;">
                                                (เหลือเวลาอีก @p.DaysRemaining วัน)
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div>
                                            <span class="badge" style="background: #fee2e2; color: #b91c1c; border: 1px solid #fca5a5; font-size: 0.8rem; padding: 4px 8px;">
                                                <i class="bi bi-exclamation-triangle-fill me-1"></i> เกินกำหนด @p.OverdueDays วัน
                                            </span>
                                            <div style="font-size: 0.75rem; color: #dc2626; font-weight: 600; margin-top: 3px;">
                                                ปรับ 3%/วัน: +฿@p.LatePenaltyAmount.ToString("N0")
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted" style="font-size: 0.82rem;">
                                        <i class="bi bi-hourglass"></i> รอส่งมอบงาน
                                    </span>
                                }
                            </td>
                            <td>
                                @if (p.PaymentStatus == PaymentStatus.Paid)
                                {
                                    <span class="badge-status badge-paid">
                                        ฿@p.Quotation?.BalanceAmount.ToString("N0")
                                    </span>
                                }
                                else if (p.OverdueDays > 0)
                                {
                                    <div>
                                        <div style="font-size: 1.05rem; font-weight: 800; color: #dc2626;">
                                            ฿@p.TotalPayableAmount.ToString("N0")
                                        </div>
                                        <div style="font-size: 0.72rem; color: #991b1b;">
                                            (เงินต้น ฿@p.Quotation?.BalanceAmount.ToString("N0") + ปรับ ฿@p.LatePenaltyAmount.ToString("N0"))
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <span class="badge-status badge-pending" style="font-size: 0.92rem; font-weight: 700;">
                                        ฿@p.Quotation?.BalanceAmount.ToString("N0")
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-1">
                                    <button class="btn btn-sm btn-outline-info" title="ดูรายละเอียดกระบวนการทั้งหมด" @onclick="() => OpenDetailsModal(p)">
                                        <i class="bi bi-eye-fill"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-primary" title="อัปเดตความคืบหน้า/บันทึกงานขั้นตอนต่างๆ" @onclick="() => OpenUpdateModal(p)">
                                        <i class="bi bi-gear-fill"></i>
                                    </button>
                                    @if (p.PaymentStatus == PaymentStatus.Paid)
                                    {
                                        <button class="btn btn-sm btn-outline-success" title="พิมพ์ใบเสร็จรับเงิน" @onclick="() => OpenReceiptPreview(p)">
                                            <i class="bi bi-file-earmark-check-fill"></i> ใบเสร็จ
                                        </button>
                                        @if (!string.IsNullOrEmpty(p.FinalPaymentSlipUrl))
                                        {
                                            <button class="btn btn-sm btn-outline-primary" title="ดูรูปภาพสลิปโอนเงินงวดสุดท้าย" @onclick="@(() => OpenImageLightbox(p.FinalPaymentSlipUrl, $"สลิปการโอนเงินงวดสุดท้าย PROJ-{p.Id}"))">
                                                <i class="bi bi-image"></i> สลิป
                                            </button>
                                        }
                                    }
                                    else if (p.StepStatus == InstallationStep.Completed && (AuthService.CurrentUser?.Role == UserRole.Admin || AuthService.CurrentUser?.Role == UserRole.ProjectManager))
                                    {
                                        <button class="btn btn-sm btn-success" title="ยืนยันการรับชำระเงินและแนบสลิปเพื่อเปิดสิทธิ์ใบเสร็จ" @onclick="() => OpenPaymentConfirmModal(p)">
                                            <i class="bi bi-cash"></i> รับเงินงวดท้าย
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-secondary" disabled title="ยังไม่ชำระเงินงวดสุดท้าย (ออกใบเสร็จไม่ได้)">
                                            <i class="bi bi-lock-fill"></i> ใบเสร็จ
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">ยังไม่มีโครงการติดตั้งที่อนุมัติเข้ามา</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal for Update Progress & Assign Team & Step Details -->
@if (isUpdateModalOpen && selectedProject != null)
{
    <div class="modal-overlay no-print">
        <div class="modal-content-custom" style="max-width: 950px; width: 95%;">
            <div class="modal-header-custom">
                <h3>อัปเดตความคืบหน้าโครงการ PROJ-@selectedProject.Id</h3>
                <button class="modal-close-btn" @onclick="CloseUpdateModal">&times;</button>
            </div>
            <div>
                <div class="modal-body-custom" style="max-height: 70vh; overflow-y: auto;">
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(380px, 1fr)); gap: 24px;">
                        
                        <!-- Left Column: General Settings -->
                        <div>
                            <h4 style="border-bottom: 2px solid rgba(255,255,255,0.06); padding-bottom: 8px; margin-bottom: 16px; color: var(--primary);">
                                <i class="bi bi-info-circle" style="margin-right: 6px;"></i> ข้อมูลทั่วไปของโครงการ
                            </h4>
                            
                            <!-- Tech Team Assignment -->
                            <div class="form-group">
                                <label class="form-label" for="proj-team">มอบหมายทีมช่างผู้รับผิดชอบ *</label>
                                <select id="proj-team" class="form-control-custom" @bind="selectedProject.TechnicianTeamId" required>
                                    <option value="">-- กรุณาเลือกทีมช่าง --</option>
                                    @foreach (var team in teams)
                                    {
                                        <option value="@team.Id">@team.TeamName (หัวหน้า: @team.LeaderName)</option>
                                    }
                                </select>
                            </div>

                            <!-- Step Tracker Indicator (Interactive) -->
                            <div class="form-group">
                                <label class="form-label">ขั้นตอนความคืบหน้างานติดตั้งปัจจุบัน *</label>
                                <div class="installation-stepper" style="margin-bottom: 30px;">
                                    <div class="stepper-progress-line">
                                        <div class="stepper-progress-line-fill" style="width: @(GetStepperProgressWidth(selectedProject.StepStatus))%"></div>
                                    </div>
                                    
                                    <div class="step-node @(GetStepNodeClass(selectedProject.StepStatus, InstallationStep.SurfacePrep))" @onclick="() => SetStep(InstallationStep.SurfacePrep)">
                                        1
                                        <span class="step-label">เตรียมพื้นผิว</span>
                                    </div>
                                    <div class="step-node @(GetStepNodeClass(selectedProject.StepStatus, InstallationStep.Priming))" @onclick="() => SetStep(InstallationStep.Priming)">
                                        2
                                        <span class="step-label">ทาสีรองพื้น</span>
                                    </div>
                                    <div class="step-node @(GetStepNodeClass(selectedProject.StepStatus, InstallationStep.EpoxyApplying))" @onclick="() => SetStep(InstallationStep.EpoxyApplying)">
                                        3
                                        <span class="step-label">เคลือบ Epoxy</span>
                                    </div>
                                    <div class="step-node @(GetStepNodeClass(selectedProject.StepStatus, InstallationStep.Completed))" @onclick="() => SetStep(InstallationStep.Completed)">
                                        4
                                        <span class="step-label">ส่งมอบงาน</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Date info -->
                            <div style="display: flex; gap: 12px; margin-top: 40px;">
                                <div class="form-group" style="flex: 1;">
                                    <label class="form-label">วันที่เริ่มติดตั้ง</label>
                                    <input type="date" class="form-control-custom" @bind="selectedProject.StartDate" />
                                </div>
                                <div class="form-group" style="flex: 1;">
                                    <label class="form-label">วันที่แล้วเสร็จ</label>
                                    <input type="date" class="form-control-custom" @bind="selectedProject.EndDate" disabled="@(selectedProject.StepStatus != InstallationStep.Completed)" />
                                </div>
                            </div>
                        </div>

                        <!-- Right Column: Step Details Editor -->
                        <div style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.06); border-radius: 12px; padding: 20px;">
                            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid rgba(255,255,255,0.06); padding-bottom: 8px; margin-bottom: 16px;">
                                <h4 style="margin: 0; color: var(--teal); font-weight: 600;">
                                    <i class="bi bi-pencil-square" style="margin-right: 6px;"></i> บันทึกขั้นตอน: @GetStepLabelOnly(selectedStepperStep)
                                </h4>
                                <select class="form-control-custom" style="width: auto; padding: 4px 8px; font-size: 0.85rem;" 
                                        value="@selectedStepperStep" @onchange="OnSelectedStepperStepChanged">
                                    <option value="@InstallationStep.SurfacePrep">1. เตรียมพื้นผิว</option>
                                    <option value="@InstallationStep.Priming">2. ทาสีรองพื้น</option>
                                    <option value="@InstallationStep.EpoxyApplying">3. เคลือบ Epoxy</option>
                                    <option value="@InstallationStep.Completed">4. ส่งมอบงาน</option>
                                </select>
                            </div>

                            <!-- Set status to this step button -->
                            @if (selectedProject.StepStatus != selectedStepperStep)
                            {
                                <button type="button" class="btn btn-sm btn-outline-info w-100 mb-3" @onclick="() => SetStep(selectedStepperStep)">
                                    <i class="bi bi-check-circle"></i> ปรับโครงการให้มาอยู่ขั้นตอน "@GetStepLabelOnly(selectedStepperStep)"
                                </button>
                            }
                            else
                            {
                                <div style="background: rgba(34,197,94,0.1); border: 1px solid rgba(34,197,94,0.2); border-radius: 6px; padding: 6px 12px; font-size: 0.85rem; color: #22c55e; margin-bottom: 16px; font-weight: 600;" class="text-center">
                                    <i class="bi bi-check-circle-fill"></i> ขั้นตอนปัจจุบันของโครงการ
                                </div>
                            }

                            <!-- Description -->
                            <div class="form-group">
                                <label class="form-label">รายละเอียดการดำเนินงานในขั้นตอนนี้</label>
                                <textarea class="form-control-custom" rows="3" @bind="currentStepDetail.Description" placeholder="พิมพ์อธิบายการทำงานในขั้นตอนนี้..."></textarea>
                            </div>

                            <!-- Photo upload -->
                            <div class="form-group">
                                <label class="form-label">รูปถ่ายหน้างาน</label>
                                <InputFile class="form-control-custom" OnChange="HandleFileSelected" accept="image/*" />
                                
                                @if (!string.IsNullOrWhiteSpace(currentStepDetail.PhotoUrl))
                                {
                                    <div style="position: relative; margin-top: 10px; border-radius: 8px; overflow: hidden; border: 1px solid rgba(255,255,255,0.1);">
                                        <img src="@currentStepDetail.PhotoUrl" style="width: 100%; max-height: 200px; object-fit: cover;" />
                                        <button type="button" class="btn btn-sm btn-danger" style="position: absolute; top: 8px; right: 8px;" @onclick="RemovePhoto">
                                            <i class="bi bi-trash"></i> ลบรูป
                                        </button>
                                    </div>
                                }
                            </div>

                            <!-- Materials section -->
                            <div style="margin-top: 20px;">
                                <h5 style="font-size: 0.95rem; font-weight: 600; color: var(--text-primary); border-bottom: 1px solid rgba(255,255,255,0.06); padding-bottom: 4px; margin-bottom: 12px;">
                                    <i class="bi bi-box-seam" style="margin-right: 6px;"></i> วัสดุอุปกรณ์ที่ใช้งานในขั้นตอนนี้
                                </h5>

                                <!-- Material adder -->
                                <div style="display: flex; gap: 8px; align-items: flex-end; margin-bottom: 12px;">
                                    <div style="flex: 2;">
                                        <label class="form-label" style="font-size: 0.75rem; margin-bottom: 4px;">เลือกวัสดุ</label>
                                        <select class="form-control-custom" @bind="newMaterialInventoryId" style="font-size: 0.85rem; padding: 8px 10px;">
                                            <option value="0">-- เลือกวัสดุจากคลัง --</option>
                                            @foreach (var inv in inventoriesList)
                                            {
                                                <option value="@inv.Id">@inv.Name (คงเหลือ: @inv.Quantity.ToString("N1") @inv.Unit)</option>
                                            }
                                        </select>
                                    </div>
                                    <div style="flex: 1;">
                                        <label class="form-label" style="font-size: 0.75rem; margin-bottom: 4px;">จำนวนที่ใช้</label>
                                        <input type="number" step="0.1" min="0.1" class="form-control-custom" @bind="newMaterialQuantity" style="font-size: 0.85rem; padding: 8px 10px;" placeholder="0.0" />
                                    </div>
                                    <button type="button" class="btn-custom btn-primary-custom" style="padding: 8px 12px; height: 38px;" @onclick="AddMaterialToStep">
                                        <i class="bi bi-plus-lg"></i> บันทึกและหักคลัง
                                    </button>
                                </div>

                                @if (!string.IsNullOrEmpty(stepErrorMessage))
                                {
                                    <div style="font-size: 0.8rem; color: #ef4444; margin-bottom: 8px;">
                                        <i class="bi bi-exclamation-triangle"></i> @stepErrorMessage
                                    </div>
                                }

                                <!-- Material list -->
                                @if (currentStepDetail.UsedMaterials != null && currentStepDetail.UsedMaterials.Any())
                                {
                                    <div style="max-height: 180px; overflow-y: auto;">
                                        <table class="table table-sm table-dark table-striped table-bordered" style="font-size: 0.82rem; border-color: rgba(255,255,255,0.06); background: rgba(0,0,0,0.2);">
                                            <thead>
                                                <tr>
                                                    <th>วัสดุ</th>
                                                    <th class="text-end" style="width: 100px;">จำนวนที่ใช้</th>
                                                    <th class="text-center" style="width: 50px;">คืนคลัง</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var mat in currentStepDetail.UsedMaterials)
                                                {
                                                    <tr>
                                                        <td>@mat.Inventory?.Name</td>
                                                        <td class="text-end">@mat.QuantityUsed.ToString("N1") @mat.Inventory?.Unit</td>
                                                        <td class="text-center">
                                                            <button type="button" class="btn btn-sm btn-link text-danger p-0" title="ลบข้อมูลและคืนวัสดุเข้าคลัง" @onclick="() => RemoveMaterialFromStep(mat)">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted text-center py-2" style="font-size: 0.8rem; background: rgba(0,0,0,0.1); border-radius: 8px; border: 1px dashed rgba(255,255,255,0.05);">
                                        ยังไม่มีการบันทึกการใช้วัสดุในขั้นตอนนี้
                                    </div>
                                }
                            </div>
                        </div>

                    </div>
                </div>
                <div class="modal-footer-custom">
                    <button type="button" class="btn-custom btn-secondary-custom" @onclick="CloseUpdateModal">ยกเลิก</button>
                    <button type="button" class="btn-custom btn-primary-custom" @onclick="SaveProjectUpdate">บันทึกความคืบหน้า</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal for Viewing Detailed Project Progress History -->
@if (isDetailsModalOpen && selectedProjectDetails != null)
{
    <div class="modal-overlay @(isPrintingDetails ? "print-section" : "no-print")" style="background-color: rgba(0,0,0,0.85); overflow-y: auto; display: flex; align-items: flex-start; padding: 40px 10px; z-index: 1100;">
        <div class="quotation-print-card" style="width: 100%; max-width: 800px; margin: auto; padding: 40px; background: white; border-radius: 8px; color: #333; box-shadow: 0 0 20px rgba(0,0,0,0.5);">
            
            <!-- Controls Header (hidden during print) -->
            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom no-print" style="border-color: #eee !important;">
                <span class="text-dark"><strong>ตรวจสอบรายงานความคืบหน้าติดตั้งก่อนพิมพ์</strong></span>
                <div class="d-flex gap-2">
                    <button class="btn btn-success" @onclick="TriggerPrintDetails">
                        <i class="bi bi-printer"></i> พิมพ์
                    </button>
                    <button class="btn btn-secondary" @onclick="CloseDetailsModal">ปิดหน้าต่าง</button>
                </div>
            </div>

            <!-- Printable Document Body -->
            <div class="print-header" style="border-bottom: 2px solid #0f2444; padding-bottom: 16px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
                <div style="display: flex; align-items: center; gap: 16px; text-align: left;">
                    <img src="images/logo.png" alt="Company Logo" style="height: 68px; width: 68px; object-fit: cover; border-radius: 8px; border: 1px solid #e2e8f0; box-shadow: 0 2px 6px rgba(0,0,0,0.06);" />
                    <div class="print-company-info">
                        <h2 style="margin: 0 0 4px 0; color: #0f2444; font-size: 1.35rem; font-weight: 800;">@companyConfig.Name</h2>
                        <p style="font-size: 0.82rem; margin: 0; color: #475569; line-height: 1.45;">
                            @companyConfig.Address<br />
                            โทร: @companyConfig.Phone | อีเมล: @companyConfig.Email | เลขผู้เสียภาษี: @companyConfig.TaxId
                        </p>
                    </div>
                </div>
                <div class="print-title-area" style="text-align: right;">
                    <h1 style="margin: 0; font-size: 1.75rem; color: #0f2444; font-weight: 800;">รายงานความคืบหน้า</h1>
                    <span style="font-size: 0.95rem; font-weight: 700; color: var(--primary);">PROGRESS REPORT</span>
                </div>
            </div>

            <div class="print-meta-grid" style="display: grid; grid-template-columns: 1fr 1fr 1.2fr; gap: 20px; margin-bottom: 24px;">
                <div class="print-meta-box" style="border: 1px solid #ddd; padding: 15px; border-radius: 6px; font-size: 0.85rem; color: #333; line-height: 1.6; text-align: left;">
                    <h4 style="margin: 0 0 8px 0; font-size: 0.95rem; border-bottom: 1px solid #eee; padding-bottom: 4px; font-weight: 700;">ข้อมูลลูกค้า</h4>
                    <strong>ชื่อลูกค้า:</strong> @selectedProjectDetails.Quotation?.Customer?.Name<br />
                    <strong>เบอร์โทรศัพท์:</strong> @selectedProjectDetails.Quotation?.Customer?.Phone<br />
                    <strong>ที่อยู่ติดตั้ง:</strong> @selectedProjectDetails.Quotation?.Customer?.Address
                </div>
                <div class="print-meta-box" style="border: 1px solid #ddd; padding: 15px; border-radius: 6px; font-size: 0.85rem; color: #333; line-height: 1.6; text-align: left;">
                    <h4 style="margin: 0 0 8px 0; font-size: 0.95rem; border-bottom: 1px solid #eee; padding-bottom: 4px; font-weight: 700;">ข้อมูลโครงการ</h4>
                    <strong>เลขที่โครงการ:</strong> PROJ-@selectedProjectDetails.Id<br />
                    <strong>อ้างอิงใบเสนอราคา:</strong> QT-@selectedProjectDetails.QuotationId<br />
                    <strong>ทีมช่างผู้รับผิดชอบ:</strong> @(selectedProjectDetails.TechnicianTeam?.TeamName ?? "-") (หัวหน้า: @(selectedProjectDetails.TechnicianTeam?.LeaderName ?? "-"))<br />
                    <strong>สถานะปัจจุบัน:</strong> @GetStepLabelOnly(selectedProjectDetails.StepStatus)
                </div>
                <div class="print-meta-box" style="border: 1px solid #ddd; padding: 15px; border-radius: 6px; font-size: 0.85rem; color: #333; line-height: 1.6; text-align: left;">
                    <h4 style="margin: 0 0 8px 0; font-size: 0.95rem; border-bottom: 1px solid #eee; padding-bottom: 4px; font-weight: 700;">ข้อมูลการชำระเงิน</h4>
                    <strong>ราคารวมโครงการ:</strong> ฿@selectedProjectDetails.Quotation?.TotalPrice.ToString("N0") บาท<br />
                    <strong style="color: #16a34a;">เงินมัดจำ (ชำระแล้ว):</strong> ฿@selectedProjectDetails.Quotation?.DepositAmount.ToString("N0") บาท<br />
                    <strong style="color: @(selectedProjectDetails.PaymentStatus == PaymentStatus.Paid ? "#16a34a" : "#ea580c"); font-weight: bold;">ยอดเงินงวดสุดท้าย:</strong> ฿@selectedProjectDetails.Quotation?.BalanceAmount.ToString("N0") บาท<br />
                    <strong>สถานะ:</strong> @(selectedProjectDetails.PaymentStatus == PaymentStatus.Paid ? "ชำระเงินครบถ้วนแล้ว" : "ค้างชำระงวดสุดท้าย")
                    
                    @if (!string.IsNullOrEmpty(selectedProjectDetails.Quotation?.PaymentSlipUrl) || !string.IsNullOrEmpty(selectedProjectDetails.FinalPaymentSlipUrl))
                    {
                        <div class="no-print mt-2 pt-2 border-top d-flex gap-2">
                            @if (!string.IsNullOrEmpty(selectedProjectDetails.Quotation?.PaymentSlipUrl))
                            {
                                <button type="button" class="btn btn-sm btn-outline-info" style="font-size: 0.75rem; padding: 2px 8px;" @onclick="@(() => OpenImageLightbox(selectedProjectDetails.Quotation.PaymentSlipUrl, $"สลิปมัดจำ QT-{selectedProjectDetails.QuotationId}"))">
                                    <i class="bi bi-receipt"></i> สลิปมัดจำ
                                </button>
                            }
                            @if (!string.IsNullOrEmpty(selectedProjectDetails.FinalPaymentSlipUrl))
                            {
                                <button type="button" class="btn btn-sm btn-outline-success" style="font-size: 0.75rem; padding: 2px 8px;" @onclick="@(() => OpenImageLightbox(selectedProjectDetails.FinalPaymentSlipUrl, $"สลิปงวดสุดท้าย PROJ-{selectedProjectDetails.Id}"))">
                                    <i class="bi bi-receipt"></i> สลิปงวดสุดท้าย
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>

            <h4 style="margin-bottom: 16px; font-weight: 700; color: #333; border-left: 4px solid var(--primary); padding-left: 8px; text-align: left;">
                รายละเอียดความคืบหน้าในแต่ละขั้นตอน
            </h4>

            <div style="display: flex; flex-direction: column; gap: 20px; margin-bottom: 30px; text-align: left;">
                @foreach (var step in Enum.GetValues<InstallationStep>())
                {
                    var stepDetail = projectStepDetails.FirstOrDefault(d => d.Step == step);
                    var isCompletedStep = selectedProjectDetails.StepStatus >= step;

                    <div style="
                        background: #fcfcfc;
                        border: 1px solid @(isCompletedStep ? "#22c55e" : "#eee");
                        border-radius: 8px;
                        padding: 15px;
                        color: #333;
                    ">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; border-bottom: 1px solid #f0f0f0; padding-bottom: 6px;">
                            <h5 style="margin: 0; font-size: 0.95rem; font-weight: 700; color: @(isCompletedStep ? "var(--teal)" : "#666");">
                                @GetStepName(step)
                            </h5>
                            <span style="
                                font-size: 0.75rem;
                                font-weight: bold;
                                padding: 2px 8px;
                                border-radius: 12px;
                                background: @(isCompletedStep ? "rgba(34,197,94,0.15)" : "#f0f0f0");
                                color: @(isCompletedStep ? "#16a34a" : "#666");
                            ">
                                @(isCompletedStep ? (selectedProjectDetails.StepStatus == step ? "กำลังดำเนินการ" : "เสร็จสิ้นแล้ว") : "ยังไม่เริ่ม")
                            </span>
                        </div>

                        @if (stepDetail != null && isCompletedStep)
                        {
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; align-items: start;">
                                <div style="font-size: 0.85rem; line-height: 1.5;">
                                    <strong>รายละเอียดการทำงาน:</strong><br />
                                    <span style="color: #555; white-space: pre-line;">
                                        @(string.IsNullOrWhiteSpace(stepDetail.Description) ? "ไม่มีรายละเอียดการทำงานบันทึกไว้" : stepDetail.Description)
                                    </span>
                                    
                                    <div style="margin-top: 10px;">
                                        <strong>วัสดุอุปกรณ์ที่ใช้งาน:</strong>
                                        @if (stepDetail.UsedMaterials != null && stepDetail.UsedMaterials.Any())
                                        {
                                            <ul style="margin: 4px 0 0 0; padding-left: 20px; color: #555;">
                                                @foreach (var mat in stepDetail.UsedMaterials)
                                                {
                                                    <li>@mat.Inventory?.Name (@mat.QuantityUsed.ToString("N1") @mat.Inventory?.Unit)</li>
                                                }
                                            </ul>
                                        }
                                        else
                                        {
                                            <span style="color: #888; margin-left: 6px;">ไม่มีการใช้วัสดุ</span>
                                        }
                                    </div>
                                </div>
                                <div style="text-align: center;">
                                    @if (!string.IsNullOrWhiteSpace(stepDetail.PhotoUrl))
                                    {
                                        <img src="@stepDetail.PhotoUrl" style="max-width: 100%; max-height: 150px; object-fit: contain; border-radius: 6px; border: 1px solid #ddd; margin-top: 4px;" />
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <span style="font-size: 0.85rem; color: #999;">ไม่มีข้อมูลบันทึกในขั้นตอนนี้</span>
                        }
                    </div>
                }
            </div>

            <!-- Signatures Section -->
            <div class="print-signatures" style="display: grid; grid-template-columns: 1fr 1fr; gap: 50px; text-align: center; margin-top: 50px; border-top: 1px solid #eee; padding-top: 30px;">
                <div style="color: #333; font-size: 0.85rem;">
                    <p style="margin-bottom: 40px;">ผู้รายงาน / หัวหน้าควบคุมทีมช่าง</p>
                    <div style="border-top: 1px solid #888; width: 220px; margin: auto; padding-top: 5px;">
                        ลงชื่อ......................................................<br />
                        วันที่ ......./......./.......
                    </div>
                </div>
                <div style="color: #333; font-size: 0.85rem;">
                    <p style="margin-bottom: 40px;">ลูกค้า / ผู้ตรวจรับงาน</p>
                    <div style="border-top: 1px solid #888; width: 220px; margin: auto; padding-top: 5px;">
                        ลงชื่อ......................................................<br />
                        วันที่ ......./......./.......
                    </div>
                </div>
            </div>

        </div>
    </div>
}

<!-- Print Preview Receipt Modal -->
