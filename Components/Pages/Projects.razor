                <img src="@lightboxImageUrl" alt="รูปภาพขยาย" style="max-width: 100%; max-height: 75vh; object-fit: contain; border-radius: 8px; box-shadow: 0 4px 20px rgba(0,0,0,0.5);" />
            </div>
            <div class="modal-footer-custom" style="background: #1e293b; border-color: rgba(255,255,255,0.08);">
                <button class="btn-custom btn-secondary-custom" @onclick="CloseImageLightbox">ปิดหน้าต่าง</button>
            </div>
        </div>
    </div>
}

@code {
    private List<InstallationProcess> projects = new();
    private List<TechnicianTeam> teams = new();
    private List<Inventory> inventoriesList = new();

    private bool isUpdateModalOpen = false;
    private InstallationProcess? selectedProject = null;

    // Selected stepper step editor states
    private InstallationStep selectedStepperStep = InstallationStep.SurfacePrep;
    private InstallationStepDetail currentStepDetail = new();
    private int newMaterialInventoryId = 0;
    private decimal newMaterialQuantity = 0;
    private string stepErrorMessage = string.Empty;

    // View progress history states
    private bool isDetailsModalOpen = false;
    private InstallationProcess? selectedProjectDetails = null;
    private List<InstallationStepDetail> projectStepDetails = new();

    // Payment confirmation states
    private bool isPaymentConfirmModalOpen = false;
    private InstallationProcess? projectToConfirmPayment = null;
    private bool hasConfirmedFinalPaymentCheckbox = false;
    private string? finalPaymentSlipDataUrl = null;
    private string finalPaymentNote = string.Empty;

    // Lightbox modal states
    private bool isLightboxOpen = false;
    private string lightboxImageUrl = string.Empty;
    private string lightboxImageTitle = string.Empty;

    // Printing receipt states
    private InstallationProcess? selectedReceiptProject = null;
    private bool isPrinting = false;
    private bool isPrintingDetails = false;
    private CompanyProfile companyConfig = new();

    protected override void OnInitialized()
    {
        LoadData();
    }

    private void LoadData()
    {
        companyConfig = Db.CompanyProfiles.FirstOrDefault() ?? new CompanyProfile();
        teams = Db.TechnicianTeams.OrderBy(t => t.TeamName).ToList();
        projects = Db.InstallationProcesses
            .Include(p => p.Quotation)
            .ThenInclude(q => q!.Customer)
            .Include(p => p.TechnicianTeam)
            .OrderByDescending(p => p.Id)
            .ToList();
        inventoriesList = Db.Inventories.OrderBy(i => i.Name).ToList();
    }

    private void OpenUpdateModal(InstallationProcess p)
    {
        selectedProject = p;
        selectedStepperStep = p.StepStatus;
        LoadStepDetail();
        isUpdateModalOpen = true;
    }

    private void CloseUpdateModal()
    {
        isUpdateModalOpen = false;
        selectedProject = null;
    }

    private void LoadStepDetail()
    {
        if (selectedProject == null) return;
        stepErrorMessage = string.Empty;
        newMaterialInventoryId = 0;
        newMaterialQuantity = 0;

        var detail = Db.InstallationStepDetails
            .Include(d => d.UsedMaterials)
            .ThenInclude(m => m.Inventory)
            .FirstOrDefault(d => d.InstallationProcessId == selectedProject.Id && d.Step == selectedStepperStep);

        if (detail != null)
        {
            currentStepDetail = detail;
        }
        else
        {
            currentStepDetail = new InstallationStepDetail
            {
                InstallationProcessId = selectedProject.Id,
                Step = selectedStepperStep,
                Description = string.Empty,
                PhotoUrl = string.Empty,
                UsedMaterials = new List<InstallationStepMaterial>()
            };
        }
    }

    private void OnSelectedStepperStepChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<InstallationStep>(e.Value?.ToString(), out var step))
        {
            // Save current step details changes to local variable first
            SaveCurrentStepDetailTemporarily();
            selectedStepperStep = step;
            LoadStepDetail();
        }
    }

    private void SaveCurrentStepDetailTemporarily()
    {
        if (selectedProject == null) return;

        // Auto-upsert step detail record
        var existing = Db.InstallationStepDetails.FirstOrDefault(d => 
            d.InstallationProcessId == selectedProject.Id && d.Step == selectedStepperStep);

        if (existing != null)
        {
            existing.Description = currentStepDetail.Description;
            existing.PhotoUrl = currentStepDetail.PhotoUrl;
            Db.InstallationStepDetails.Update(existing);
        }
        else
        {
            if (!string.IsNullOrWhiteSpace(currentStepDetail.Description) || !string.IsNullOrWhiteSpace(currentStepDetail.PhotoUrl))
            {
                Db.InstallationStepDetails.Add(currentStepDetail);
            }
        }
        Db.SaveChanges();
    }

    private void SetStep(InstallationStep step)
    {
        if (selectedProject != null)
        {
            selectedProject.StepStatus = step;
            if (step == InstallationStep.Completed)
            {
                selectedProject.EndDate = DateTime.Now;
            }
            else
            {
                selectedProject.EndDate = null;
            }
            
            // Sync current editor to the new step
            SaveCurrentStepDetailTemporarily();
            selectedStepperStep = step;
            LoadStepDetail();
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            try
            {
                var resizedImage = await file.RequestImageFileAsync("image/jpeg", 800, 600);
                var buffer = new byte[resizedImage.Size];
                using (var stream = resizedImage.OpenReadStream(1024 * 1024 * 10)) // Max 10MB
                {
                    int totalRead = 0;
                    while (totalRead < buffer.Length)
                    {
                        int read = await stream.ReadAsync(buffer, totalRead, buffer.Length - totalRead);
                        if (read == 0) break;
                        totalRead += read;
                    }
                }
                currentStepDetail.PhotoUrl = $"data:image/jpeg;base64,{Convert.ToBase64String(buffer)}";
                SaveCurrentStepDetailTemporarily();
            }
            catch (Exception ex)
            {
                stepErrorMessage = "เกิดข้อผิดพลาดในการโหลดไฟล์รูปภาพ: " + ex.Message;
            }
        }
    }

    private void RemovePhoto()
    {
        currentStepDetail.PhotoUrl = string.Empty;
        SaveCurrentStepDetailTemporarily();
    }

    private void AddMaterialToStep()
    {
        stepErrorMessage = string.Empty;

        if (newMaterialInventoryId == 0)
        {
            stepErrorMessage = "กรุณาเลือกวัสดุอุปกรณ์";
            return;
        }

        if (newMaterialQuantity <= 0)
        {
            stepErrorMessage = "กรุณาระบุจำนวนที่มากกว่า 0";
            return;
        }

        var inv = Db.Inventories.Find(newMaterialInventoryId);
        if (inv == null) return;

        if (inv.Quantity < newMaterialQuantity)
        {
            stepErrorMessage = $"วัสดุคงเหลือในคลังไม่พอใช้ (คงเหลือ: {inv.Quantity.ToString("N1")} {inv.Unit})";
            return;
        }

        // Deduct from inventory in real-time
        inv.Quantity -= newMaterialQuantity;
        Db.Inventories.Update(inv);

        // Ensure current step detail is saved to db to have a valid ID
        if (currentStepDetail.Id == 0)
        {
            Db.InstallationStepDetails.Add(currentStepDetail);
            Db.SaveChanges();
        }

        var usedMat = new InstallationStepMaterial
        {
            InstallationStepDetailId = currentStepDetail.Id,
            InventoryId = newMaterialInventoryId,
            QuantityUsed = newMaterialQuantity
        };

        Db.InstallationStepMaterials.Add(usedMat);
        Db.SaveChanges();

        // Reload data
        inventoriesList = Db.Inventories.OrderBy(i => i.Name).ToList();
        LoadStepDetail();
    }

    private void RemoveMaterialFromStep(InstallationStepMaterial mat)
    {
        // Restore stock to inventory in real-time
        var inv = Db.Inventories.Find(mat.InventoryId);
        if (inv != null)
        {
            inv.Quantity += mat.QuantityUsed;
            Db.Inventories.Update(inv);
        }

        Db.InstallationStepMaterials.Remove(mat);
        Db.SaveChanges();

        // Reload data
        inventoriesList = Db.Inventories.OrderBy(i => i.Name).ToList();
        LoadStepDetail();
    }

    private void SaveProjectUpdate()
    {
        if (selectedProject != null)
        {
            // Save current editor details first
            SaveCurrentStepDetailTemporarily();

            // If completed, update technicians status back to Available
            if (selectedProject.StepStatus == InstallationStep.Completed && selectedProject.TechnicianTeamId.HasValue)
            {
                var techsInTeam = Db.Technicians.Where(t => t.TeamId == selectedProject.TechnicianTeamId.Value).ToList();
                foreach (var tech in techsInTeam)
                {
                    tech.Status = TechnicianStatus.Available;
                    Db.Technicians.Update(tech);
                }
            }
            else if (selectedProject.TechnicianTeamId.HasValue)
            {
                // Set technicians in that team to Busy
                var techsInTeam = Db.Technicians.Where(t => t.TeamId == selectedProject.TechnicianTeamId.Value).ToList();
                foreach (var tech in techsInTeam)
                {
                    tech.Status = TechnicianStatus.Busy;
                    Db.Technicians.Update(tech);
                }
            }

            Db.InstallationProcesses.Update(selectedProject);
            Db.SaveChanges();
            isUpdateModalOpen = false;
            LoadData();
        }
    }

    // Details viewer popup handlers
    private void OpenDetailsModal(InstallationProcess p)
    {
        selectedProjectDetails = p;
        projectStepDetails = Db.InstallationStepDetails
            .Include(d => d.UsedMaterials)
            .ThenInclude(m => m.Inventory)
            .Where(d => d.InstallationProcessId == p.Id)
            .ToList();
        isDetailsModalOpen = true;
    }

    private void CloseDetailsModal()
    {
        isDetailsModalOpen = false;
        selectedProjectDetails = null;
        projectStepDetails = new();
        isPrintingDetails = false;
    }

    private async Task TriggerPrintDetails()
    {
        isPrintingDetails = true;
        StateHasChanged();
        await Task.Delay(200);
        await JS.InvokeVoidAsync("window.print");
        isPrintingDetails = false;
        StateHasChanged();
    }

    private void OpenPaymentConfirmModal(InstallationProcess p)
    {
        projectToConfirmPayment = p;
        hasConfirmedFinalPaymentCheckbox = false;
        finalPaymentSlipDataUrl = null;
        finalPaymentNote = string.Empty;
        isPaymentConfirmModalOpen = true;
    }

    private void ClosePaymentConfirmModal()
    {
        isPaymentConfirmModalOpen = false;
        projectToConfirmPayment = null;
        hasConfirmedFinalPaymentCheckbox = false;
        finalPaymentSlipDataUrl = null;
        finalPaymentNote = string.Empty;
    }

    private async Task OnFinalPaymentSlipSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            try
            {
                var resizedFile = await file.RequestImageFileAsync(file.ContentType, 1200, 1200);
                using var stream = resizedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var base64 = Convert.ToBase64String(ms.ToArray());
                finalPaymentSlipDataUrl = $"data:{file.ContentType};base64,{base64}";
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error uploading slip: {ex.Message}");
            }
        }
    }

    private void ConfirmFinalPaymentSave()
    {
        if (projectToConfirmPayment == null || !hasConfirmedFinalPaymentCheckbox) return;

        var penalty = projectToConfirmPayment.LatePenaltyAmount;
        var totalAmount = projectToConfirmPayment.TotalPayableAmount;
        var overdueDays = projectToConfirmPayment.OverdueDays;

        var note = finalPaymentNote;
        if (overdueDays > 0)
        {
            var penaltyNote = $"[รวมค่าปรับชำระล่าช้า {overdueDays} วัน (3%/วัน) +฿{penalty:N0}]";
            note = string.IsNullOrWhiteSpace(note) ? penaltyNote : $"{note} {penaltyNote}";
        }

        // 1. Mark Project as Paid and attach slip details
        projectToConfirmPayment.PaymentStatus = PaymentStatus.Paid;
        projectToConfirmPayment.PaymentDate = DateTime.Now;
        projectToConfirmPayment.FinalPaymentSlipUrl = finalPaymentSlipDataUrl;
        projectToConfirmPayment.FinalPaymentNote = note;
        projectToConfirmPayment.FinalPaymentApprovedBy = AuthService.CurrentUser?.FullName ?? "ฝ่ายบัญชีการเงิน";
        Db.InstallationProcesses.Update(projectToConfirmPayment);

        // 2. Automatically log final balance payment into Finance ledger
        var finalIncomeEntry = new Finance
        {
            Type = FinanceType.Income,
            Amount = totalAmount,
            Description = $"[รายรับงวดสุดท้าย] ค่าติดตั้งพื้นส่วนที่เหลือ ใบเสนอราคา QT-{projectToConfirmPayment.QuotationId} ลูกค้า {projectToConfirmPayment.Quotation?.Customer?.Name}" + (!string.IsNullOrEmpty(note) ? $" ({note})" : ""),
            RecordedDate = DateTime.Now,
            QuotationId = projectToConfirmPayment.QuotationId,
            ReferenceNo = $"REC-FN{projectToConfirmPayment.QuotationId}"
        };
        Db.Finances.Add(finalIncomeEntry);

        Db.SaveChanges();
        ClosePaymentConfirmModal();
        LoadData();
    }

    private void OpenImageLightbox(string imageUrl, string title)
    {
        lightboxImageUrl = imageUrl;
        lightboxImageTitle = title;
        isLightboxOpen = true;
    }

    private void CloseImageLightbox()
    {
        isLightboxOpen = false;
        lightboxImageUrl = string.Empty;
        lightboxImageTitle = string.Empty;
    }

    // Receipt printing methods
    private void OpenReceiptPreview(InstallationProcess p)
    {
        selectedReceiptProject = p;
    }

    private void CloseReceiptPreview()
    {
        selectedReceiptProject = null;
        isPrinting = false;
    }

    private async Task TriggerPrint()
    {
        isPrinting = true;
        StateHasChanged();
        await Task.Delay(200);
        await JS.InvokeVoidAsync("window.print");
        isPrinting = false;
        StateHasChanged();
    }

    private string GetStepName(InstallationStep step) => step switch
    {
        InstallationStep.SurfacePrep => "1. เตรียมพื้นผิว",
        InstallationStep.Priming => "2. ทาสีรองพื้น",
        InstallationStep.EpoxyApplying => "3. เคลือบ Epoxy",
        InstallationStep.Completed => "4. เสร็จสิ้น (ส่งมอบงาน)",
        _ => ""
    };

    private string GetStepLabelOnly(InstallationStep step) => step switch
    {
        InstallationStep.SurfacePrep => "เตรียมพื้นผิว",
        InstallationStep.Priming => "ทาสีรองพื้น",
        InstallationStep.EpoxyApplying => "เคลือบ Epoxy",
        InstallationStep.Completed => "ส่งมอบงาน",
        _ => ""
    };

    private string GetStepBadgeClass(InstallationStep step) => step switch
    {
        InstallationStep.SurfacePrep => "draft",
        InstallationStep.Priming => "warning",
        InstallationStep.EpoxyApplying => "busy",
        InstallationStep.Completed => "approved",
        _ => ""
    };

    private string GetPaymentStatusText(PaymentStatus status) => status switch
    {
        PaymentStatus.Paid => "ชำระเงินครบถ้วน",
        PaymentStatus.Pending => "ค้างชำระส่วนที่เหลือ",
        _ => ""
    };

    // Stepper helpers
    private int GetStepperProgressWidth(InstallationStep step) => step switch
    {
        InstallationStep.SurfacePrep => 0,
        InstallationStep.Priming => 33,
        InstallationStep.EpoxyApplying => 66,
        InstallationStep.Completed => 100,
        _ => 0
    };

    private string GetStepNodeClass(InstallationStep currentStep, InstallationStep nodeStep)
    {
        if (currentStep == nodeStep) return "active";
        if (currentStep > nodeStep) return "completed";
        return "";
    }
}
