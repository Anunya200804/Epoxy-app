@code {
    private List<Quotation> quotations = new();
    private List<Customer> customers = new();

    private bool isModalOpen = false;
    private Quotation newQuotation = new();
    private decimal autoDeposit = 0;

    // Customer Combobox states
    private string customerSearchText = string.Empty;
    private bool showCustomerDropdown = false;
    private List<Customer> customerSuggestions = new();
    private bool isNewCustomer = false;

    // New Customer Details
    private string newCustomerPhone = string.Empty;
    private string newCustomerAddress = string.Empty;
    private string newCustomerLineId = string.Empty;

    // Pricing state & parameters
    private string selectedFloorType = "Epoxy Coating";
    private int workingDays = 1;
    private bool isHolidaySurcharge = false;
    private decimal additionalThicknessMm = 0;
    private EpoxyFloorManager.Services.PricingCalculationResult? currentCalcResult = null;

    // Print states
    private Quotation? selectedPrintQuote = null;
    private bool isPrinting = false;
    private CompanyProfile companyConfig = new();

    protected override void OnInitialized()
    {
        LoadData();
    }

    private void LoadData()
    {
        companyConfig = Db.CompanyProfiles.FirstOrDefault() ?? new CompanyProfile();
        customers = Db.Customers.OrderBy(c => c.Name).ToList();
        quotations = Db.Quotations
            .Include(q => q.Customer)
            .OrderByDescending(q => q.Id)
            .ToList();
    }

    private void SetHoliday(bool isHoliday)
    {
        isHolidaySurcharge = isHoliday;
        OnFloorTypeOrAreaChanged();
    }

    private void OnFloorTypeOrAreaChanged()
    {
        if (newQuotation.AreaSqm > 0)
        {
            currentCalcResult = PricingService.CalculatePrice(
                selectedFloorType,
                newQuotation.AreaSqm,
                workingDays > 0 ? workingDays : 1,
                isHolidaySurcharge,
                selectedFloorType == "PU" ? additionalThicknessMm : 0m
            );

            newQuotation.PricePerUnit = Math.Round(currentCalcResult.PricePerUnit, 2);

            var rateDesc = currentCalcResult.IsDailyRate 
                ? $" (คิดราคาเหมาแบบรายวัน {workingDays} วัน)" 
                : (isHolidaySurcharge ? " (อัตราวันหยุด/เร่งด่วน)" : "");
            var thickDesc = (selectedFloorType == "PU" && additionalThicknessMm > 0) ? $" ความหนา +{additionalThicknessMm} มม." : "";
            newQuotation.JobDescription = $"บริการทำพื้น {selectedFloorType}{thickDesc} พื้นที่ {newQuotation.AreaSqm:N0} ตร.ม.{rateDesc}";
        }
        else
        {
            currentCalcResult = null;
        }

        RecalculateTotals();
    }

    private void OpenAddModal()
    {
        selectedFloorType = "Epoxy Coating";
        workingDays = 1;
        isHolidaySurcharge = false;
        additionalThicknessMm = 0;

        newQuotation = new Quotation
        {
            AreaSqm = 100,
            Status = QuotationStatus.Draft
        };

        OnFloorTypeOrAreaChanged();

        customerSearchText = string.Empty;
        showCustomerDropdown = false;
        isNewCustomer = false;
        newCustomerPhone = string.Empty;
        newCustomerAddress = string.Empty;
        newCustomerLineId = string.Empty;

        RecalculateTotals();
        isModalOpen = true;
    }

    private void OpenEditModal(Quotation q)
    {
        newQuotation = new Quotation
        {
            Id = q.Id,
            CustomerId = q.CustomerId,
            JobDescription = q.JobDescription,
            AreaSqm = q.AreaSqm,
            PricePerUnit = q.PricePerUnit,
            DepositAmount = q.DepositAmount,
            Status = q.Status,
            CreatedDate = q.CreatedDate
        };

        if (q.JobDescription.Contains("PU", StringComparison.OrdinalIgnoreCase))
            selectedFloorType = "PU";
        else if (q.JobDescription.Contains("Self-Leveling", StringComparison.OrdinalIgnoreCase))
            selectedFloorType = "Epoxy Self-Leveling";
        else
            selectedFloorType = "Epoxy Coating";

        isHolidaySurcharge = q.JobDescription.Contains("วันหยุด", StringComparison.OrdinalIgnoreCase) || q.JobDescription.Contains("เร่งด่วน", StringComparison.OrdinalIgnoreCase);
        workingDays = 1;
        additionalThicknessMm = 0;

        if (newQuotation.AreaSqm > 0)
        {
            currentCalcResult = PricingService.CalculatePrice(
                selectedFloorType,
                newQuotation.AreaSqm,
                workingDays,
                isHolidaySurcharge,
                selectedFloorType == "PU" ? additionalThicknessMm : 0m
            );
        }

        var cust = customers.FirstOrDefault(c => c.Id == q.CustomerId);
        if (cust != null)
        {
            customerSearchText = cust.Name;
            isNewCustomer = false;
        }
        else
        {
            customerSearchText = string.Empty;
            isNewCustomer = false;
        }

        showCustomerDropdown = false;
        newCustomerPhone = string.Empty;
        newCustomerAddress = string.Empty;
        newCustomerLineId = string.Empty;

        RecalculateTotals();
        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
    }

    private void RecalculateTotals()
    {
        autoDeposit = newQuotation.TotalPrice * 0.30m;
        newQuotation.DepositAmount = Math.Round(autoDeposit);
    }

    private void RecalculateBalance()
    {
        if (newQuotation.DepositAmount > newQuotation.TotalPrice)
        {
            newQuotation.DepositAmount = newQuotation.TotalPrice;
        }
    }

    // Customer Combobox Event Handlers
    private void OnCustomerInput(ChangeEventArgs e)
    {
        customerSearchText = e.Value?.ToString() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(customerSearchText))
        {
            customerSuggestions = new();
            showCustomerDropdown = false;
            newQuotation.CustomerId = 0;
            isNewCustomer = false;
        }
        else
        {
            var q = customerSearchText.ToLower();
            customerSuggestions = customers
                .Where(c => c.Name.ToLower().Contains(q))
                .Take(8)
                .ToList();
            showCustomerDropdown = customerSuggestions.Any();

            var exactMatch = customers.FirstOrDefault(c => c.Name.Equals(customerSearchText, StringComparison.OrdinalIgnoreCase));
            if (exactMatch != null)
            {
                newQuotation.CustomerId = exactMatch.Id;
                isNewCustomer = false;
            }
            else
            {
                newQuotation.CustomerId = 0;
                isNewCustomer = true;
            }
        }
    }

    private void OnCustomerFocus()
    {
        if (!string.IsNullOrWhiteSpace(customerSearchText))
        {
            var q = customerSearchText.ToLower();
            customerSuggestions = customers
                .Where(c => c.Name.ToLower().Contains(q))
                .Take(8)
                .ToList();
        }
        else
        {
            customerSuggestions = customers.Take(8).ToList();
        }
        showCustomerDropdown = customerSuggestions.Any();
    }

    private void OnCustomerBlur()
    {
        _ = Task.Run(async () =>
        {
            await Task.Delay(200);
            showCustomerDropdown = false;
            await InvokeAsync(StateHasChanged);
        });
    }

    private void SelectCustomer(Customer cust)
    {
        customerSearchText = cust.Name;
        newQuotation.CustomerId = cust.Id;
        isNewCustomer = false;
        showCustomerDropdown = false;

        newCustomerPhone = string.Empty;
        newCustomerAddress = string.Empty;
        newCustomerLineId = string.Empty;
    }

    private void SaveQuotation()
    {
        if (isNewCustomer && string.IsNullOrWhiteSpace(customerSearchText))
        {
            return;
        }
        if (!isNewCustomer && newQuotation.CustomerId == 0)
        {
            return;
        }

        // 1. If customer is new, save it first
        if (isNewCustomer)
        {
            var newCust = new Customer
            {
                Name = customerSearchText.Trim(),
                Phone = newCustomerPhone.Trim(),
                Address = newCustomerAddress.Trim(),
                LineId = newCustomerLineId.Trim(),
                CreatedDate = DateTime.Now
            };
            Db.Customers.Add(newCust);
            Db.SaveChanges(); // Get Id
            newQuotation.CustomerId = newCust.Id;
        }

        // 2. Save the quotation
        if (newQuotation.Id == 0)
        {
            newQuotation.CreatedDate = DateTime.Now;
            Db.Quotations.Add(newQuotation);
        }
        else
        {
            var existing = Db.Quotations.Find(newQuotation.Id);
            if (existing != null)
            {
                existing.CustomerId = newQuotation.CustomerId;
                existing.JobDescription = newQuotation.JobDescription;
                existing.AreaSqm = newQuotation.AreaSqm;
                existing.PricePerUnit = newQuotation.PricePerUnit;
                existing.DepositAmount = newQuotation.DepositAmount;
                existing.Status = newQuotation.Status;
                Db.Quotations.Update(existing);
            }
        }

        Db.SaveChanges();
        isModalOpen = false;
        LoadData();
    }

    // Approval & Slip Modal States
    private bool isApproveModalOpen = false;
    private Quotation? approvingQuote = null;
    private string? approveSlipDataUrl = null;
    private string approvePaymentNote = string.Empty;

    // View Slip Modal State
    private Quotation? selectedSlipQuote = null;

    private async Task OnFormSlipSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file != null)
            {
                using var stream = file.OpenReadStream(5 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                newQuotation.PaymentSlipUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error uploading form slip: {ex.Message}");
        }
    }

    private void OpenApproveModal(Quotation q)
    {
        approvingQuote = q;
        approveSlipDataUrl = q.PaymentSlipUrl;
        approvePaymentNote = q.PaymentNote ?? string.Empty;
        isApproveModalOpen = true;
    }

    private void CloseApproveModal()
    {
        isApproveModalOpen = false;
        approvingQuote = null;
        approveSlipDataUrl = null;
        approvePaymentNote = string.Empty;
    }

    private async Task OnApproveSlipSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file != null)
            {
                using var stream = file.OpenReadStream(5 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                approveSlipDataUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error uploading approve slip: {ex.Message}");
        }
    }

    private void ConfirmApproveQuotation()
    {
        if (approvingQuote == null) return;

        var q = Db.Quotations.Find(approvingQuote.Id);
        if (q != null)
        {
            q.Status = QuotationStatus.Approved;
            q.PaymentSlipUrl = approveSlipDataUrl;
            q.ApprovedDate = DateTime.Now;
            q.ApprovedBy = AuthService.CurrentUser?.FullName ?? "ผู้ดูแลระบบ";
            q.PaymentNote = approvePaymentNote;
            Db.Quotations.Update(q);

            var hasProcess = Db.InstallationProcesses.Any(p => p.QuotationId == q.Id);
            if (!hasProcess)
            {
                var process = new InstallationProcess
                {
                    QuotationId = q.Id,
                    StepStatus = InstallationStep.SurfacePrep,
                    StartDate = DateTime.Now,
                    PaymentStatus = PaymentStatus.Pending
                };
                Db.InstallationProcesses.Add(process);
            }

            var noteDesc = !string.IsNullOrEmpty(approvePaymentNote) ? $" ({approvePaymentNote})" : "";
            var financeEntry = new Finance
            {
                Type = FinanceType.Income,
                Amount = q.DepositAmount,
                Description = $"[รายรับค่ามัดจำ] เงินมัดจำใบเสนอราคา QT-{q.Id} ลูกค้า {q.Customer?.Name}{noteDesc}",
                RecordedDate = DateTime.Now,
                QuotationId = q.Id,
                ReferenceNo = $"REC-DP{q.Id}"
            };
            Db.Finances.Add(financeEntry);

            Db.SaveChanges();
        }

        CloseApproveModal();
        LoadData();
    }

    private void OpenSlipModal(Quotation q)
    {
        selectedSlipQuote = q;
    }

    private void CloseSlipModal()
    {
        selectedSlipQuote = null;
    }

    private void CancelQuotation(Quotation q)
    {
        q.Status = QuotationStatus.Cancelled;
        Db.Quotations.Update(q);
        Db.SaveChanges();
        LoadData();
    }

    private void OpenPrintPreview(Quotation q)
    {
        selectedPrintQuote = q;
    }

    private void ClosePrintPreview()
    {
        selectedPrintQuote = null;
        isPrinting = false;
    }

    private async Task TriggerPrint()
    {
        isPrinting = true;
        StateHasChanged();
        await Task.Delay(200);
        await JS.InvokeVoidAsync("window.print");
        isPrinting = false;
        StateHasChanged();
    }

    private string GetStatusName(QuotationStatus status) => status switch
    {
        QuotationStatus.Draft => "ฉบับร่าง",
        QuotationStatus.Approved => "อนุมัติแล้ว",
        QuotationStatus.Cancelled => "ยกเลิกแล้ว",
        _ => ""
    };
}
