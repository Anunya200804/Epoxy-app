@page "/quotations"
@inject EpoxyDbContext Db
@inject AuthService AuthService
@inject EpoxyFloorManager.Services.PricingService PricingService
@inject IJSRuntime JS

<PageTitle>ใบเสนอราคา - ระบบการจัดการพื้น Epoxy</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4 no-print">
    <div>
        <h2 class="mb-1" style="font-weight: 700; color: var(--primary);">ระบบใบเสนอราคา</h2>
        <p class="text-muted mb-0">สร้าง ออกแบบ ใบเสนอราคา คำนวณเงินมัดจำ และติดตามสถานะความพึงพอใจของลูกค้า</p>
    </div>
    @if (AuthService.CurrentUser?.Role == UserRole.Admin || AuthService.CurrentUser?.Role == UserRole.ProjectManager)
    {
        <button class="btn-custom btn-primary-custom" @onclick="OpenAddModal">
            <i class="bi bi-file-earmark-plus-fill"></i> สร้างใบเสนอราคาใหม่
        </button>
    }
</div>

<!-- Quotations List -->
<div class="card-panel no-print">
    <div class="custom-table-container">
        <table class="custom-table">
            <thead>
                <tr>
                    <th style="white-space: nowrap;">เลขที่ใบเสนอราคา</th>
                    <th>ลูกค้า</th>
                    <th>รายละเอียดงาน</th>
                    <th class="text-end">พื้นที่ (ตร.ม.)</th>
                    <th class="text-end">ราคา/หน่วย</th>
                    <th class="text-end">ยอดรวม</th>
                    <th class="text-end">มัดจำ</th>
                    <th class="text-end">ยอดค้างชำระ</th>
                    <th>สลิปโอนเงิน</th>
                    <th>สถานะ</th>
                    <th class="text-center">จัดการ</th>
                </tr>
            </thead>
            <tbody>
                @if (quotations.Any())
                {
                    @foreach (var q in quotations)
                    {
                        <tr>
                            <td style="white-space: nowrap;"><strong>QT-@q.Id</strong></td>
                            <td>@q.Customer?.Name</td>
                            <td style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@q.JobDescription</td>
                            <td class="text-end">@q.AreaSqm.ToString("N0")</td>
                            <td class="text-end">฿@q.PricePerUnit.ToString("N0")</td>
                            <td class="text-end" style="font-weight: 600;">฿@q.TotalPrice.ToString("N0")</td>
                            <td class="text-end" style="color: var(--success);">฿@q.DepositAmount.ToString("N0")</td>
                            <td class="text-end" style="color: var(--secondary);">฿@q.BalanceAmount.ToString("N0")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(q.PaymentSlipUrl))
                                {
                                    <button class="btn btn-sm btn-outline-success d-flex align-items-center gap-1" style="font-size: 0.78rem; padding: 2px 8px; border-radius: 6px;" @onclick="() => OpenSlipModal(q)" title="คลิกเพื่อดูรูปภาพสลิป">
                                        <i class="bi bi-receipt-cutoff"></i> ดูสลิป
                                    </button>
                                }
                                else if (q.Status == QuotationStatus.Approved)
                                {
                                    <span class="text-muted" style="font-size: 0.78rem;">ไม่มีสลิป</span>
                                }
                                else
                                {
                                    <span class="text-muted" style="font-size: 0.78rem;">รอชำระ</span>
                                }
                            </td>
                            <td>
                                <span class="badge-status badge-@q.Status.ToString().ToLower()">
                                    @GetStatusName(q.Status)
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-1">
                                    <button class="btn btn-sm btn-outline-secondary" title="พิมพ์" @onclick="() => OpenPrintPreview(q)">
                                        <i class="bi bi-file-earmark-pdf-fill text-danger"></i>
                                    </button>
                                    @if (AuthService.CurrentUser?.Role == UserRole.Admin || AuthService.CurrentUser?.Role == UserRole.ProjectManager)
                                    {
                                        <button class="btn btn-sm btn-outline-primary" title="แก้ไขข้อมูลใบเสนอราคา" @onclick="() => OpenEditModal(q)">
                                            <i class="bi bi-pencil-fill"></i>
                                        </button>
                                        @if (q.Status == QuotationStatus.Draft)
                                        {
                                            <button class="btn btn-sm btn-outline-success" title="ยืนยันการชำระเงินและอนุมัติใบเสนอราคา" @onclick="() => OpenApproveModal(q)">
                                                <i class="bi bi-check-circle-fill"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" title="ยกเลิกใบเสนอราคา" @onclick="() => CancelQuotation(q)">
                                                <i class="bi bi-x-circle-fill"></i>
                                            </button>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="11" class="text-center text-muted py-4">ยังไม่มีการบันทึกใบเสนอราคาในระบบ</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Popup for Add/Edit Quotation -->
@if (isModalOpen)
{
    <div class="modal-overlay no-print">
        <div class="modal-content-custom" style="max-width: 700px;">
            <div class="modal-header-custom">
                <h3>@(newQuotation.Id == 0 ? "สร้างใบเสนอราคาใหม่" : $"แก้ไขใบเสนอราคา QT-{newQuotation.Id}")</h3>
                <button class="modal-close-btn" @onclick="CloseModal">&times;</button>
            </div>
            <div>
                <div class="modal-body-custom" style="max-height: 70vh; overflow-y: auto;">
                    
                    <!-- Customer selection (Combobox) -->
                    <div class="form-group" style="position: relative;">
                        <label class="form-label">เลือกลูกค้า * <span style="font-size: 0.75rem; color: var(--text-secondary);">(พิมพ์ค้นหา หรือ พิมพ์ชื่อลูกค้าใหม่)</span></label>
                        <div style="position: relative;">
                            <input type="text" class="form-control-custom"
                                   value="@customerSearchText"
                                   @oninput="OnCustomerInput"
                                   @onfocus="OnCustomerFocus"
                                   @onblur="OnCustomerBlur"
                                   autocomplete="off"
                                   placeholder="พิมพ์ค้นหา หรือ กรอกชื่อลูกค้าคนใหม่..." />
                            @if (!string.IsNullOrWhiteSpace(customerSearchText))
                            {
                                <div style="
                                    position: absolute;
                                    right: 12px;
                                    top: 50%;
                                    transform: translateY(-50%);
                                    font-size: 0.7rem;
                                    padding: 2px 8px;
                                    border-radius: 6px;
                                    font-weight: 600;
                                    pointer-events: none;
                                    @(isNewCustomer 
                                        ? "background: rgba(34,197,94,0.15); color: #22c55e; border: 1px solid rgba(34,197,94,0.3);" 
                                        : "background: rgba(99,102,241,0.15); color: #818cf8; border: 1px solid rgba(99,102,241,0.3);")
                                ">
                                    @(isNewCustomer ? "✨ ลูกค้าใหม่" : "📦 ลูกค้าเก่า")
                                </div>
                            }
                        </div>

                        <!-- Dropdown suggestions -->
                        @if (showCustomerDropdown && customerSuggestions.Any())
                        {
                            <div style="
                                position: absolute;
                                top: 100%;
                                left: 0;
                                right: 0;
                                z-index: 1000;
                                background: #ffffff;
                                border: 1px solid rgba(0, 0, 0, 0.15);
                                border-radius: 8px;
                                box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
                                max-height: 200px;
                                overflow-y: auto;
                                margin-top: 4px;
                            ">
                                <div style="padding: 8px 14px; font-size: 0.75rem; color: #475569; border-bottom: 1px solid rgba(0, 0, 0, 0.08); font-weight: 600; background: #f8fafc;">
                                    <i class="bi bi-person-lines-fill" style="margin-right: 6px; color: var(--primary);"></i>
                                    เลือกลูกค้าเดิมที่มีอยู่
                                </div>
                                @foreach (var cust in customerSuggestions)
                                {
                                    var currentCust = cust;
                                    <div @onmousedown="() => SelectCustomer(currentCust)" style="
                                        padding: 10px 14px;
                                        cursor: pointer;
                                        transition: all 0.15s ease;
                                        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
                                        display: flex;
                                        justify-content: space-between;
                                        align-items: center;
                                    " onmouseover="this.style.background='rgba(59, 130, 246, 0.08)'" onmouseout="this.style.background='transparent'">
                                        <div>
                                            <div style="font-weight: 600; font-size: 0.9rem; color: #0f172a;">@currentCust.Name</div>
                                            <div style="font-size: 0.78rem; color: #475569; margin-top: 2px;">
                                                โทร: @currentCust.Phone
                                            </div>
                                        </div>
                                        <i class="bi bi-arrow-return-left" style="color: #94a3b8; font-size: 0.82rem;"></i>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- New customer fields (only show if it's a new customer) -->
                    @if (isNewCustomer && !string.IsNullOrWhiteSpace(customerSearchText))
                    {
                        <div style="
                            background: rgba(34,197,94,0.05);
                            border: 1px dashed rgba(34,197,94,0.3);
                            border-radius: 12px;
                            padding: 16px;
                            margin-bottom: 16px;
                        ">
                            <h4 style="margin-top: 0; margin-bottom: 12px; font-size: 0.9rem; color: #22c55e; font-weight: 700;">
                                <i class="bi bi-person-plus-fill" style="margin-right: 6px;"></i> ข้อมูลลูกค้าใหม่
                            </h4>
                            <div class="row" style="display: flex; gap: 12px; margin-bottom: 12px;">
                                <div class="form-group" style="flex: 1; margin-bottom: 0;">
                                    <label class="form-label" style="color: #22c55e; font-size: 0.78rem;">เบอร์โทรศัพท์ *</label>
                                    <input type="text" class="form-control-custom" @bind="newCustomerPhone" placeholder="กรอกเบอร์โทรศัพท์ลูกค้า" required />
                                </div>
                                <div class="form-group" style="flex: 1; margin-bottom: 0;">
                                    <label class="form-label" style="color: #22c55e; font-size: 0.78rem;">ไลน์ไอดี</label>
                                    <input type="text" class="form-control-custom" @bind="newCustomerLineId" placeholder="กรอกไลน์ไอดี (ถ้ามี)" />
                                </div>
                            </div>
                            <div class="form-group" style="margin-bottom: 0;">
                                <label class="form-label" style="color: #22c55e; font-size: 0.78rem;">ที่อยู่ติดตั้ง / ส่งเอกสาร *</label>
                                <textarea class="form-control-custom" rows="2" @bind="newCustomerAddress" placeholder="กรอกที่อยู่ของลูกค้าอย่างละเอียด" required></textarea>
                            </div>
                        </div>
                    }

                    <!-- 1. Floor Type & Area -->
                    <div class="row" style="display: flex; gap: 12px; margin-bottom: 12px;">
                        <div class="form-group" style="flex: 1; margin-bottom: 0;">
                            <label class="form-label">ประเภทพื้น *</label>
                            <select class="form-control-custom" @bind="selectedFloorType" @bind:after="OnFloorTypeOrAreaChanged">
                                <option value="Epoxy Coating">Epoxy Coating (อีพ็อกซี่เคลือบ)</option>
                                <option value="Epoxy Self-Leveling">Epoxy Self-Leveling (อีพ็อกซี่เทราบ)</option>
                                <option value="PU">PU (พอลิยูรีเทน)</option>
                            </select>
                        </div>
                        <div class="form-group" style="flex: 1; margin-bottom: 0;">
                            <label class="form-label" for="quote-area">พื้นที่หน้างาน (ตารางเมตร) *</label>
                            <input type="number" step="0.1" min="1" id="quote-area" class="form-control-custom" 
                                   @bind="newQuotation.AreaSqm" @bind:after="OnFloorTypeOrAreaChanged" required />
                        </div>
                    </div>

                    <!-- 2. Conditional Pricing Options based on Area and Floor Type -->
                    @if (newQuotation.AreaSqm > 0 && newQuotation.AreaSqm < 300)
                    {
                        <div class="form-group" style="background: rgba(245, 158, 11, 0.08); border-left: 3px solid var(--warning); padding: 10px 14px; border-radius: 6px; margin-bottom: 12px;">
                            <label class="form-label" style="color: #b45309; font-weight: 600; font-size: 0.82rem; margin-bottom: 4px;">
                                <i class="bi bi-calendar-week me-1"></i> พื้นที่ &lt; 300 ตร.ม. (คิดราคาเหมาแบบรายวัน) — จำนวนวันทำงาน *
                            </label>
                            <input type="number" min="1" step="1" class="form-control-custom" 
                                   @bind="workingDays" @bind:after="OnFloorTypeOrAreaChanged" placeholder="ระบุจำนวนวันทำงาน เช่น 1, 2, 3" />
                            <small class="text-muted" style="font-size: 0.75rem; margin-top: 2px; display: block;">
                                อัตราเหมามาตรฐาน: Epoxy 6,000 บาท/วัน, PU 8,000 บาท/วัน
                            </small>
                        </div>
                    }
                    else if (newQuotation.AreaSqm >= 300)
                    {
                        <div class="form-group" style="background: rgba(59, 130, 246, 0.08); border-left: 3px solid var(--primary); padding: 10px 14px; border-radius: 6px; margin-bottom: 12px;">
                            <label class="form-label" style="color: var(--primary); font-weight: 600; font-size: 0.82rem; margin-bottom: 4px;">
                                เงื่อนไขวันทำงาน (พื้นที่ &ge; 300 ตร.ม. คิดราคาต่อ ตร.ม.)
                            </label>
                            <div style="display: flex; gap: 8px;">
                                <button type="button" class="btn btn-sm @(!isHolidaySurcharge ? "btn-primary" : "btn-outline-secondary")" 
                                        style="flex: 1; font-size: 0.82rem; padding: 6px;" @onclick="() => SetHoliday(false)">
                                    <i class="bi bi-sun"></i> วันธรรมดา
                                </button>
                                <button type="button" class="btn btn-sm @(isHolidaySurcharge ? "btn-warning text-dark font-weight-bold" : "btn-outline-secondary")" 
                                        style="flex: 1; font-size: 0.82rem; padding: 6px;" @onclick="() => SetHoliday(true)">
                                    <i class="bi bi-moon-stars"></i> วันหยุด/เทศกาล/เร่งด่วน (2x)
                                </button>
                            </div>
                        </div>
                    }

                    @if (selectedFloorType == "PU")
                    {
                        <div class="form-group" style="background: rgba(124, 58, 237, 0.08); border-left: 3px solid #7c3aed; padding: 10px 14px; border-radius: 6px; margin-bottom: 12px;">
                            <label class="form-label" style="color: #7c3aed; font-weight: 600; font-size: 0.82rem; margin-bottom: 4px;">
                                <i class="bi bi-layers-half me-1"></i> ความหนาเพิ่มเติม PU (มม.) (ทุก 2 มม. +20 บ./ตร.ม.)
                            </label>
                            <input type="number" min="0" step="0.5" class="form-control-custom" 
                                   @bind="additionalThicknessMm" @bind:after="OnFloorTypeOrAreaChanged" placeholder="0" />
                        </div>
                    }

                    <!-- 3. Job Description -->
                    <div class="form-group">
                        <label class="form-label" for="quote-job">รายการรายละเอียดงาน *</label>
                        <textarea id="quote-job" class="form-control-custom" rows="2" @bind="newQuotation.JobDescription" required placeholder="เช่น บริการเคลือบพื้นผิว Epoxy Coating"></textarea>
                    </div>

                    <!-- 4. Price per unit & Total Price -->
                    <div class="row" style="display: flex; gap: 12px; margin-bottom: 12px;">
                        <div class="form-group" style="flex: 1;">
                            <label class="form-label" for="quote-ppu">ราคาต่อหน่วย (บาท / ตร.ม.) *</label>
                            <input type="number" step="0.01" min="0.01" id="quote-ppu" class="form-control-custom" 
                                   @bind="newQuotation.PricePerUnit" @bind:after="RecalculateTotals" required />
                            @if (currentCalcResult != null)
                            {
                                <small class="text-muted" style="font-size: 0.75rem; margin-top: 2px; display: block;">
                                    @if (currentCalcResult.IsDailyRate)
                                    {
                                        <span>คำนวณจาก: ฿@currentCalcResult.BaseRateUsed.ToString("N0")/วัน × @workingDays วัน</span>
                                    }
                                    else
                                    {
                                        <span>คำนวณจาก: ฿@currentCalcResult.BaseRateUsed.ToString("N0")/ตร.ม.@(currentCalcResult.ThicknessSurcharge > 0 ? " + หนาเพิ่ม" : "")</span>
                                    }
                                </small>
                            }
                        </div>
                        <div class="form-group" style="flex: 1;">
                            <label class="form-label">ราคารวมคำนวณอัตโนมัติ (บาท)</label>
                            <input type="text" class="form-control-custom" value="฿@newQuotation.TotalPrice.ToString("N0")" disabled style="background-color: #f1f5f9; font-weight: bold; color: var(--primary); font-size: 1.05rem;" />
                        </div>
                    </div>

                    <!-- 5. Deposit & Balance -->
                    <div class="row" style="display: flex; gap: 12px; margin-bottom: 12px;">
                        <div class="form-group" style="flex: 1;">
                            <label class="form-label" for="quote-dep">ยอดเงินมัดจำ (กรอกจำนวนเงินได้) *</label>
                            <input type="number" step="1" id="quote-dep" class="form-control-custom" @bind="newQuotation.DepositAmount" @bind:after="RecalculateBalance" required />
                            <div class="form-text text-muted" style="font-size: 0.75rem; margin-top: 4px;">
                                ค่ามัดจำเริ่มต้นระบบตั้งไว้ที่ 30% = ฿@autoDeposit.ToString("N0")
                            </div>
                        </div>
                        <div class="form-group" style="flex: 1;">
                            <label class="form-label">ยอดเงินคงเหลือค้างชำระหลังติดตั้งเสร็จ</label>
                            <input type="text" class="form-control-custom" value="฿@newQuotation.BalanceAmount.ToString("N0")" disabled style="background-color: #f1f5f9; font-weight: bold; color: var(--primary);" />
                        </div>
                    </div>

                    <!-- 6. Slip Attachment (Optional) -->
                    <div class="form-group mb-0" style="background: rgba(99,102,241,0.05); border: 1px dashed rgba(99,102,241,0.3); border-radius: 8px; padding: 12px; margin-top: 12px;">
                        <label class="form-label" style="font-size: 0.85rem; font-weight: 600; color: var(--primary); margin-bottom: 4px;">
                            <i class="bi bi-paperclip me-1"></i> แนบรูปภาพสลิปโอนเงิน (ถ้ามี)
                        </label>
                        <InputFile OnChange="OnFormSlipSelected" accept="image/*" class="form-control-custom" style="padding: 6px; font-size: 0.82rem;" />
                        @if (!string.IsNullOrEmpty(newQuotation.PaymentSlipUrl))
                        {
                            <div class="d-flex align-items-center gap-2 mt-2">
                                <img src="@newQuotation.PaymentSlipUrl" alt="Slip preview" style="max-height: 55px; border-radius: 4px; border: 1px solid #cbd5e1;" />
                                <span class="text-success" style="font-size: 0.78rem;"><i class="bi bi-check-circle-fill me-1"></i>แนบสลิปแล้ว</span>
                                <button type="button" class="btn btn-sm btn-link text-danger p-0" style="font-size: 0.78rem; text-decoration: none;" @onclick="() => newQuotation.PaymentSlipUrl = null">
                                    <i class="bi bi-trash"></i> ลบรูป
                                </button>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer-custom">
                    <button type="button" class="btn-custom btn-secondary-custom" @onclick="CloseModal">ยกเลิก</button>
                    <button type="button" class="btn-custom btn-primary-custom" @onclick="SaveQuotation">บันทึกใบเสนอราคา</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal for Confirm Payment & Approve Quotation -->
@if (isApproveModalOpen && approvingQuote != null)
{
    <div class="modal-overlay no-print" style="z-index: 1150;">
        <div class="modal-content-custom" style="max-width: 520px;">
            <div class="modal-header-custom" style="background: linear-gradient(135deg, #10b981, #059669); color: white;">
                <h3 style="color: white; margin: 0; font-size: 1.1rem; font-weight: 700;">
                    <i class="bi bi-check2-circle me-1"></i> ยืนยันการชำระเงินและอนุมัติใบเสนอราคา
                </h3>
                <button class="modal-close-btn" style="color: white;" @onclick="CloseApproveModal">&times;</button>
            </div>
            <div class="modal-body-custom" style="padding: 20px;">
                <!-- Summary Card -->
                <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px 14px; margin-bottom: 16px;">
                    <div class="d-flex justify-content-between mb-1" style="font-size: 0.85rem;">
                        <span class="text-muted">เลขที่ใบเสนอราคา:</span>
                        <strong>QT-@approvingQuote.Id</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1" style="font-size: 0.85rem;">
                        <span class="text-muted">ลูกค้า:</span>
                        <strong>@approvingQuote.Customer?.Name</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1" style="font-size: 0.85rem;">
                        <span class="text-muted">ยอดรวมทั้งโครงการ:</span>
                        <strong>฿@approvingQuote.TotalPrice.ToString("N0")</strong>
                    </div>
                    <div class="d-flex justify-content-between pt-2 border-top">
                        <span style="font-size: 0.9rem; font-weight: 600; color: #059669;">ยอดเงินมัดจำที่ต้องชำระ:</span>
                        <strong style="font-size: 1.15rem; color: #059669;">฿@approvingQuote.DepositAmount.ToString("N0")</strong>
                    </div>
                </div>

                <!-- Slip Upload Box -->
                <div class="form-group mb-3">
                    <label class="form-label" style="font-weight: 600; color: #1e293b;">
