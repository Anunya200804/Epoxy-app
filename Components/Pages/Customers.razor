<!-- Modal Popup for Attendance History -->
@if (isAttendanceHistoryOpen && selectedAttendanceTech != null)
{
    <div class="modal-overlay">
        <div class="modal-content-custom" style="max-width: 600px; width: 95%;">
            <div class="modal-header-custom" style="background: linear-gradient(135deg, #0284c7, #0ea5e9);">
                <h3><i class="bi bi-clock-history" style="margin-right: 8px;"></i>ประวัติการทำงานของ @selectedAttendanceTech.FullName</h3>
                <button class="modal-close-btn" @onclick="CloseAttendanceHistoryModal">&times;</button>
            </div>
            <div>
                <div class="modal-body-custom" style="max-height: 60vh; overflow-y: auto;">
                    <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 10px; padding: 14px; margin-bottom: 16px; font-size: 0.9rem; line-height: 1.6;">
                        <div><strong>ชื่อ-นามสกุล:</strong> @selectedAttendanceTech.FullName</div>
                        <div><strong>ตำแหน่ง:</strong> @selectedAttendanceTech.Position</div>
                        <div><strong>กลุ่มทีมสังกัด:</strong> @(selectedAttendanceTech.Team?.TeamName ?? "ไม่มีสังกัด")</div>
                    </div>

                    <h4 style="margin: 0 0 10px 0; font-size: 0.95rem; font-weight: 700; color: var(--text-primary);">บันทึกประวัติการทำงานล่าสุด (ย้อนหลังสูงสุด 60 วัน)</h4>
                    <div class="custom-table-container">
                        <table class="custom-table" style="font-size: 0.85rem;">
                            <thead>
                                <tr>
                                    <th>วันที่</th>
                                    <th>สถานะ</th>
                                    <th>ผู้บันทึก</th>
                                    <th>หมายเหตุ</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (attendanceHistory.Any())
                                {
                                    @foreach (var record in attendanceHistory)
                                    {
                                        var currentRecord = record;
                                        <tr>
                                            <td><strong>@currentRecord.Date.ToString("dd/MM/yyyy")</strong></td>
                                            <td>
                                                <span class="badge-status @GetAttendanceBadgeClass(currentRecord.Status)">
                                                    @GetAttendanceStatusText(currentRecord.Status)
                                                </span>
                                            </td>
                                            <td>@currentRecord.RecordedBy</td>
                                            <td>
                                                <input type="text" class="form-control-custom" style="padding: 2px 6px; font-size: 0.8rem; margin: 0; background: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.1);" 
                                                       value="@currentRecord.Note" @onchange="(e) => SaveAttendanceNote(currentRecord.Id, e.Value?.ToString())" placeholder="คลิกเพื่อเพิ่มโน้ต..." />
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-4">ไม่มีประวัติการทำงานบันทึกไว้</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer-custom">
                    <button type="button" class="btn-custom btn-secondary-custom" @onclick="CloseAttendanceHistoryModal">ปิดหน้าต่าง</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string activeTab = "customers";
    private string customerSearchQuery = string.Empty;
    private string techSearchQuery = string.Empty;
    private string filterStatus = string.Empty;

    private List<Customer> customers = new();
    private List<Customer> filteredCustomers = new();
    private List<Technician> technicians = new();
    private List<Technician> filteredTechs = new();
    private List<TechnicianTeam> teams = new();

    // Modal states
    private bool isCustomerModalOpen = false;
    private Customer editingCustomer = new();
    private bool isTechModalOpen = false;
    private Technician editingTech = new();
    private bool isTeamModalOpen = false;
    private TechnicianTeam editingTeam = new();

    // Attendance states
    private Dictionary<int, AttendanceStatus> todayAttendanceMap = new();
    private bool isAttendanceHistoryOpen = false;
    private Technician? selectedAttendanceTech = null;
    private List<TechnicianAttendance> attendanceHistory = new();
    // Delete states
    private Customer? customerToDelete = null;
    private Technician? techToDelete = null;
    private TechnicianTeam? teamToDelete = null;

    // Filter
    private int filterTeamId = 0;
    private int selectedUnassignedTechId = 0;

    protected override void OnInitialized()
    {
        var uri = NavigationManager.Uri.ToLower();
        if (uri.Contains("technicians"))
        {
            activeTab = "techs";
        }
        else
        {
            activeTab = "customers";
        }
        LoadAllData();
    }

    private void LoadAllData()
    {
        customers = Db.Customers.OrderByDescending(c => c.Id).ToList();
        teams = Db.TechnicianTeams.Include(t => t.Technicians).OrderBy(t => t.Id).ToList();
        technicians = Db.Technicians.Include(t => t.Team).OrderByDescending(t => t.Id).ToList();
        
        LoadTodayAttendance();
        SearchCustomers();
        SearchTechs();
    }

    private void LoadTodayAttendance()
    {
        var today = DateTime.Today;
        var records = Db.TechnicianAttendances
            .Where(a => a.Date.Date == today)
            .ToList();

        todayAttendanceMap = new Dictionary<int, AttendanceStatus>();
        foreach (var tech in technicians)
        {
            var record = records.FirstOrDefault(r => r.TechnicianId == tech.Id);
            todayAttendanceMap[tech.Id] = record?.Status ?? AttendanceStatus.Working;
        }
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
    }

    // Customer Search and CRUD Actions
    private void SearchCustomers()
    {
        if (string.IsNullOrWhiteSpace(customerSearchQuery))
        {
            filteredCustomers = customers;
        }
        else
        {
            var q = customerSearchQuery.ToLower();
            filteredCustomers = customers
                .Where(c => c.Name.ToLower().Contains(q) || c.Phone.Contains(q) || (c.LineId != null && c.LineId.ToLower().Contains(q)))
                .ToList();
        }
    }

    private void ClearCustomerSearch()
    {
        customerSearchQuery = string.Empty;
        SearchCustomers();
    }

    private void OpenAddCustomerModal()
    {
        editingCustomer = new Customer();
        isCustomerModalOpen = true;
    }

    private void OpenEditCustomerModal(Customer customer)
    {
        editingCustomer = new Customer
        {
            Id = customer.Id,
            Name = customer.Name,
            Phone = customer.Phone,
            Address = customer.Address,
            LineId = customer.LineId,
            CreatedDate = customer.CreatedDate
        };
        isCustomerModalOpen = true;
    }

    private void CloseCustomerModal()
    {
        isCustomerModalOpen = false;
    }

    private void SaveCustomer()
    {
        if (editingCustomer.Id == 0)
        {
            editingCustomer.CreatedDate = DateTime.Now;
            Db.Customers.Add(editingCustomer);
        }
        else
        {
            var existing = Db.Customers.Find(editingCustomer.Id);
            if (existing != null)
            {
                existing.Name = editingCustomer.Name;
                existing.Phone = editingCustomer.Phone;
                existing.Address = editingCustomer.Address;
                existing.LineId = editingCustomer.LineId;
                Db.Customers.Update(existing);
            }
        }
        
        Db.SaveChanges();
        isCustomerModalOpen = false;
        LoadAllData();
    }

    private void ConfirmDeleteCustomer(Customer customer)
    {
        customerToDelete = customer;
    }

    private void CancelDeleteCustomer()
    {
        customerToDelete = null;
    }

    private void DeleteCustomer()
    {
        if (customerToDelete != null)
        {
            Db.Customers.Remove(customerToDelete);
            Db.SaveChanges();
            customerToDelete = null;
            LoadAllData();
        }
    }

    // Technician Search, Toggle Status and CRUD Actions
    private void SearchTechs()
    {
        if (string.IsNullOrWhiteSpace(techSearchQuery))
        {
            filteredTechs = technicians;
        }
        else
        {
            var q = techSearchQuery.ToLower();
            filteredTechs = technicians
                .Where(t => t.FullName.ToLower().Contains(q) || t.Phone.Contains(q) || t.Position.ToLower().Contains(q))
                .ToList();
        }

        if (filterTeamId > 0)
        {
            filteredTechs = filteredTechs.Where(t => t.TeamId == filterTeamId).ToList();
        }
    }

    private void ClearTechSearch()
    {
        techSearchQuery = string.Empty;
        filterTeamId = 0;
        SearchTechs();
    }

    // --- Attendance methods ---
    private AttendanceStatus GetTodayAttendance(int techId)
    {
        return todayAttendanceMap.TryGetValue(techId, out var status) ? status : AttendanceStatus.Working;
    }

    private void SetTodayAttendance(int techId, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var val))
        {
            todayAttendanceMap[techId] = (AttendanceStatus)val;
        }
    }

    private int GetTodayCount(AttendanceStatus status)
    {
        return todayAttendanceMap.Count(x => x.Value == status);
    }

    private void SaveAllAttendanceToday()
    {
        var today = DateTime.Today;
        var currentUser = AuthService.CurrentUser?.FullName ?? "System";

        foreach (var kvp in todayAttendanceMap)
        {
            var existing = Db.TechnicianAttendances
                .FirstOrDefault(a => a.TechnicianId == kvp.Key && a.Date.Date == today);

            if (existing != null)
            {
                existing.Status = kvp.Value;
                existing.RecordedBy = currentUser;
                Db.TechnicianAttendances.Update(existing);
            }
            else
            {
                Db.TechnicianAttendances.Add(new TechnicianAttendance
                {
                    TechnicianId = kvp.Key,
                    Date = today,
                    Status = kvp.Value,
                    RecordedBy = currentUser
                });
            }
        }
        Db.SaveChanges();
    }

    private void OpenAttendanceHistoryModal(Technician tech)
    {
        selectedAttendanceTech = tech;
        attendanceHistory = Db.TechnicianAttendances
            .Where(a => a.TechnicianId == tech.Id)
            .OrderByDescending(a => a.Date)
            .Take(60)
            .ToList();
        isAttendanceHistoryOpen = true;
    }

    private void CloseAttendanceHistoryModal()
    {
        isAttendanceHistoryOpen = false;
        selectedAttendanceTech = null;
        attendanceHistory = new();
    }

    private void SaveAttendanceNote(int recordId, string? note)
    {
        var record = Db.TechnicianAttendances.Find(recordId);
        if (record != null)
        {
            record.Note = note ?? string.Empty;
            Db.TechnicianAttendances.Update(record);
            Db.SaveChanges();
            if (selectedAttendanceTech != null)
            {
                attendanceHistory = Db.TechnicianAttendances
                    .Where(a => a.TechnicianId == selectedAttendanceTech.Id)
                    .OrderByDescending(a => a.Date)
                    .Take(60)
                    .ToList();
            }
        }
    }

    private void RemoveMemberFromTeam(Technician member)
    {
        member.TeamId = null;
        Db.Technicians.Update(member);
        Db.SaveChanges();
        LoadAllData();
    }

    private void AddExistingTechToTeam()
    {
        if (selectedUnassignedTechId > 0 && editingTeam.Id > 0)
        {
            var tech = Db.Technicians.Find(selectedUnassignedTechId);
            if (tech != null)
            {
                tech.TeamId = editingTeam.Id;
                Db.Technicians.Update(tech);
                Db.SaveChanges();
                selectedUnassignedTechId = 0;
                LoadAllData();
            }
        }
    }

    private void OpenAddTechDirectlyToTeamModal()
    {
        editingTech = new Technician
        {
            Status = TechnicianStatus.Available,
            TeamId = editingTeam.Id
        };
        isTechModalOpen = true;
    }

    private string GetAttendanceStatusText(AttendanceStatus status) => status switch
    {
        AttendanceStatus.Working => "ทำงาน",
        AttendanceStatus.Leave => "ลา",
        AttendanceStatus.Absent => "ขาด",
        _ => ""
    };

    private string GetAttendanceBadgeClass(AttendanceStatus status) => status switch
    {
        AttendanceStatus.Working => "badge-approved",
        AttendanceStatus.Leave => "badge-draft",
        AttendanceStatus.Absent => "badge-cancelled",
        _ => ""
    };

    private string GetAttendanceBgColor(AttendanceStatus status) => status switch
    {
        AttendanceStatus.Working => "rgba(34,197,94,0.12)",
        AttendanceStatus.Leave => "rgba(245,158,11,0.12)",
        AttendanceStatus.Absent => "rgba(239,68,68,0.12)",
        _ => "transparent"
    };

    private string GetAttendanceTextColor(AttendanceStatus status) => status switch
    {
        AttendanceStatus.Working => "#22c55e",
        AttendanceStatus.Leave => "#f59e0b",
        AttendanceStatus.Absent => "#ef4444",
        _ => "var(--text-primary)"
    };

    private void ToggleTechStatus(Technician tech)
    {
        tech.Status = tech.Status == TechnicianStatus.Available ? TechnicianStatus.Busy : TechnicianStatus.Available;
        Db.Technicians.Update(tech);
        Db.SaveChanges();
        LoadAllData();
    }

    private void OpenAddTechModal()
    {
        editingTech = new Technician { Status = TechnicianStatus.Available };
        isTechModalOpen = true;
    }

    private void OpenEditTechModal(Technician tech)
    {
        editingTech = new Technician
        {
            Id = tech.Id,
            FullName = tech.FullName,
            Phone = tech.Phone,
            Position = tech.Position,
            TeamId = tech.TeamId,
            Status = tech.Status
        };
        isTechModalOpen = true;
    }

    private void CloseTechModal()
    {
        isTechModalOpen = false;
    }

    private void SaveTech()
    {
        if (editingTech.Id == 0)
        {
            Db.Technicians.Add(editingTech);
        }
        else
        {
            var existing = Db.Technicians.Find(editingTech.Id);
            if (existing != null)
            {
                existing.FullName = editingTech.FullName;
                existing.Phone = editingTech.Phone;
                existing.Position = editingTech.Position;
                existing.TeamId = editingTech.TeamId;
                existing.Status = editingTech.Status;
                Db.Technicians.Update(existing);
            }
        }
        Db.SaveChanges();
        isTechModalOpen = false;
        LoadAllData();
    }

    private void ConfirmDeleteTech(Technician tech)
    {
        techToDelete = tech;
    }

    private void CancelDeleteTech()
    {
        techToDelete = null;
    }

    private void DeleteTech()
    {
        if (techToDelete != null)
        {
            Db.Technicians.Remove(techToDelete);
            Db.SaveChanges();
            techToDelete = null;
            LoadAllData();
        }
    }

    // Team CRUD Actions
    private void OpenAddTeamModal()
    {
        editingTeam = new TechnicianTeam();
        isTeamModalOpen = true;
    }

    private void OpenEditTeamModal(TechnicianTeam team)
    {
        editingTeam = new TechnicianTeam
        {
            Id = team.Id,
            TeamName = team.TeamName,
            LeaderName = team.LeaderName
        };
        isTeamModalOpen = true;
    }

    private void CloseTeamModal()
    {
        isTeamModalOpen = false;
    }

    private void SaveTeam()
    {
        if (editingTeam.Id == 0)
        {
            Db.TechnicianTeams.Add(editingTeam);
        }
        else
        {
            var existing = Db.TechnicianTeams.Find(editingTeam.Id);
            if (existing != null)
            {
                existing.TeamName = editingTeam.TeamName;
                existing.LeaderName = editingTeam.LeaderName;
                Db.TechnicianTeams.Update(existing);
            }
        }
        Db.SaveChanges();
        isTeamModalOpen = false;
        LoadAllData();
    }

    private void ConfirmDeleteTeam(TechnicianTeam team)
    {
        teamToDelete = team;
    }

    private void CancelDeleteTeam()
    {
        teamToDelete = null;
    }

    private void DeleteTeam()
    {
        if (teamToDelete != null)
        {
            Db.TechnicianTeams.Remove(teamToDelete);
            Db.SaveChanges();
            teamToDelete = null;
            LoadAllData();
        }
    }

    private string GetStatusText(TechnicianStatus status) => status switch
    {
        TechnicianStatus.Available => "ว่าง",
        TechnicianStatus.Busy => "ไม่ว่าง",
        _ => ""
    };
}
