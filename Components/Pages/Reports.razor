@page "/reports"
@inject EpoxyDbContext Db
@inject IJSRuntime JS
@inject AuthService AuthService

<PageTitle>รายงานสรุปผล - ระบบการจัดการพื้น Epoxy</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4 no-print">
    <div>
        <h2 class="mb-1" style="font-weight: 700; color: var(--primary);">ระบบรายงานสรุปผล</h2>
        <p class="text-muted mb-0">ส่งออกข้อมูลโครงการแบบครบชุด ทั้งใบเสนอราคา สลิปการเงิน และรูปภาพขั้นตอนการทำงานจริง</p>
    </div>
</div>

<!-- Filters Panel -->
<div class="card-panel no-print mb-4">
    <h4 style="font-weight: 600; margin-bottom: 16px;"><i class="bi bi-funnel"></i> ตัวกรองรายงาน</h4>
    <div class="row align-items-end g-3" style="display: flex; gap: 12px; flex-wrap: wrap;">
        <div style="flex: 1.5; min-width: 260px;">
            <label class="form-label">ประเภทรายงาน *</label>
            <select class="form-control-custom" @bind="reportType" @bind:after="RunReport">
                <option value="AllInOne">1. รายงานสรุปโครงการแบบละเอียด (ใบเสนอราคา + สลิปการเงิน + รูปภาพงาน)</option>
                <option value="Quotation">2. รายงานใบเสนอราคา (ตารางสรุป)</option>
                <option value="Receipt">3. รายงานใบเสร็จรับเงิน</option>
                <option value="Project">4. รายงานความคืบหน้าโครงการติดตั้ง</option>
            </select>
        </div>

        @if (reportType == "AllInOne" || reportType == "Project")
        {
            <div style="flex: 1.2; min-width: 220px;">
                <label class="form-label">เลือกโครงการ / งาน</label>
                <select class="form-control-custom" @bind="selectedJobId" @bind:after="RunReport">
                    <option value="0">-- แสดงทุกโครงการ --</option>
                    @foreach (var q in allQuotationsForFilter)
                    {
                        <option value="@q.Id">QT-@q.Id : @(q.Customer?.Name ?? "-") (@(q.JobDescription))</option>
                    }
                </select>
            </div>
        }

        <div style="flex: 1; min-width: 140px;">
            <label class="form-label">ตั้งแต่วันที่ *</label>
            <input type="date" class="form-control-custom" @bind="startDate" @bind:after="RunReport" />
        </div>
        <div style="flex: 1; min-width: 140px;">
            <label class="form-label">ถึงวันที่ *</label>
            <input type="date" class="form-control-custom" @bind="endDate" @bind:after="RunReport" />
        </div>
        <div style="flex: 1; min-width: 180px; display: flex; align-items: flex-end; gap: 8px;">
            <button class="btn-custom btn-primary-custom flex-fill justify-content-center" @onclick="PrintReport">
                <i class="bi bi-printer"></i> พิมพ์
            </button>
            <button class="btn-custom btn-secondary-custom" @onclick="ClearReport" title="ล้างค่าตัวกรอง">
                <i class="bi bi-x-circle"></i> ล้างค่า
            </button>
        </div>
    </div>
</div>

<!-- Printable Report Container -->
<div class="@(isPrinting ? "print-section" : "")">

<style>
    /* Formal Business Document Styles */
    .doc-sheet {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 4px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.07);
        padding: 24px 28px;
        margin-bottom: 28px;
        max-width: 900px;
        margin-left: auto;
        margin-right: auto;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Sarabun", "TH Sarabun New", sans-serif;
        color: #0f172a;
        box-sizing: border-box;
    }

    .doc-header-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 8px;
    }

    .doc-header-table td {
        vertical-align: top;
        padding: 0;
    }

    .doc-logo-img {
        height: 64px;
        width: 64px;
        object-fit: cover;
        border-radius: 6px;
        border: 1px solid #cbd5e1;
        margin-right: 14px;
    }

    .doc-company-title {
        font-size: 1.15rem;
        font-weight: 800;
        color: #0f2444;
        margin: 0 0 2px 0;
        line-height: 1.25;
    }

    .doc-company-info {
        font-size: 0.76rem;
        color: #475569;
        margin: 0;
        line-height: 1.45;
    }

    .doc-title-main {
        font-size: 1.22rem;
        font-weight: 800;
        color: #0f2444;
        margin: 0;
        text-align: right;
        line-height: 1.2;
        white-space: nowrap;
    }

    .doc-title-en {
        font-size: 0.72rem;
        font-weight: 700;
        color: #1e40af;
        letter-spacing: 0.8px;
        text-align: right;
        margin-bottom: 4px;
        white-space: nowrap;
    }

    .doc-ref-table {
        margin-left: auto;
        border-collapse: collapse;
        font-size: 0.76rem;
    }

    .doc-ref-table td {
        padding: 1px 4px;
        vertical-align: middle;
    }

    .doc-double-divider {
        border-bottom: 2px solid #0f2444;
        border-top: 1px solid #94a3b8;
        height: 3px;
        margin-bottom: 10px;
    }

    .doc-section-heading {
        font-size: 0.82rem;
        font-weight: 700;
        color: #0f2444;
        background-color: #f1f5f9;
        padding: 4px 8px;
        border: 1px solid #94a3b8;
        border-bottom: none;
        margin-top: 8px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .doc-grid-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.76rem;
        border: 1px solid #94a3b8;
        margin-bottom: 6px;
    }

    .doc-grid-table th, .doc-grid-table td {
        border: 1px solid #94a3b8;
        padding: 4px 7px;
        vertical-align: middle;
    }

    .doc-grid-table th {
        background-color: #f8fafc;
        font-weight: 700;
        color: #1e293b;
        text-align: center;
    }

    .doc-cell-label {
        background-color: #f8fafc;
        font-weight: 600;
        color: #334155;
        width: 19%;
    }

    .doc-cell-value {
        color: #0f172a;
    }

    /* 4-Step Audit Grid */
    .doc-steps-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 6px;
        margin-bottom: 6px;
    }

    .doc-step-box {
        border: 1px solid #94a3b8;
        background: #ffffff;
        padding: 5px;
        font-size: 0.72rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .doc-step-header {
        font-weight: 700;
        font-size: 0.74rem;
        color: #0f2444;
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 3px;
        margin-bottom: 4px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .doc-step-badge {
        font-size: 0.65rem;
        padding: 1px 4px;
        border-radius: 2px;
        font-weight: 600;
    }

    .badge-done { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
    .badge-wip  { background: #fef9c3; color: #854d0e; border: 1px solid #fef08a; }
    .badge-wait { background: #f1f5f9; color: #64748b; border: 1px solid #e2e8f0; }

    .doc-step-photo {
        height: 80px;
        width: 100%;
        object-fit: cover;
        border: 1px solid #cbd5e1;
        border-radius: 2px;
        margin-bottom: 4px;
        display: block;
    }

    .doc-step-no-photo {
        height: 80px;
        width: 100%;
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        color: #64748b;
        font-size: 0.68rem;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        margin-bottom: 4px;
        border-radius: 2px;
    }

    .doc-step-desc {
        font-size: 0.7rem;
        color: #334155;
        line-height: 1.35;
        min-height: 32px;
        margin-bottom: 3px;
        white-space: pre-line;
    }

    .doc-step-materials {
        font-size: 0.67rem;
        color: #475569;
        border-top: 1px solid #f1f5f9;
        padding-top: 2px;
        line-height: 1.25;
    }

    /* Slips Attachment Row */
    .doc-slips-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        border: 1px solid #94a3b8;
        padding: 5px 8px;
        background: #f8fafc;
        margin-bottom: 6px;
    }

    .doc-slip-card {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .doc-slip-img {
        height: 52px;
        max-width: 80px;
        object-fit: contain;
        border: 1px solid #cbd5e1;
        background: #fff;
        border-radius: 2px;
        cursor: pointer;
    }

    /* Certification Statement & Signatures */
    .doc-cert-statement {
        font-size: 0.72rem;
        color: #334155;
        line-height: 1.4;
        border: 1px solid #94a3b8;
        padding: 5px 8px;
        background: #f8fafc;
        margin-top: 4px;
        margin-bottom: 6px;
    }

    .doc-signature-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 4px;
    }

    .doc-signature-table td {
        width: 50%;
        text-align: center;
        vertical-align: top;
        padding: 3px 12px;
    }

    .doc-sig-role {
        font-weight: 700;
        font-size: 0.76rem;
        color: #0f2444;
        margin-bottom: 26px;
    }

    .doc-sig-dots {
        border-top: 1px solid #475569;
        width: 200px;
        margin: 0 auto;
        padding-top: 3px;
        font-size: 0.72rem;
        line-height: 1.45;
    }

    /* Footer */
    .doc-footer-bar {
        border-top: 1px solid #94a3b8;
        padding-top: 3px;
        margin-top: 6px;
        display: flex;
        justify-content: space-between;
        font-size: 0.67rem;
        color: #64748b;
    }

    /* Print Specific Media Query */
    @@media print {
        @@page {
            size: A4 portrait;
            margin: 6mm 8mm 6mm 8mm;
        }

        html, body {
            background: #ffffff !important;
            color: #000000 !important;
            font-size: 8pt !important;
            margin: 0 !important;
            padding: 0 !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        .no-print {
            display: none !important;
        }

        .doc-sheet {
            page-break-inside: avoid !important;
            break-inside: avoid !important;
            page-break-after: always !important;
            break-after: page !important;
            border: 1px solid #334155 !important;
            border-radius: 0 !important;
            box-shadow: none !important;
            padding: 6mm 8mm 5mm 8mm !important;
            margin: 0 0 0 0 !important;
            width: 100% !important;
            max-width: none !important;
            box-sizing: border-box !important;
        }

        .doc-sheet:last-child {
            page-break-after: auto !important;
            break-after: auto !important;
        }

        .doc-step-photo {
            height: 72px !important;
        }

        .doc-step-no-photo {
            height: 72px !important;
        }

        .doc-sig-role {
            margin-bottom: 22px !important;
        }
    }
</style>

    <!-- 1. All-in-One Comprehensive Dossier (แบบฟอร์มเอกสารรายงานสรุปผลและส่งมอบงานโครงการ) -->
    @if (reportType == "AllInOne" || reportType == "Project")
    {
        @if (dossierReport.Any())
        {
            @foreach (var item in dossierReport)
            {
                var q = item.Quotation;
                var proj = item.Project;
                var stepList = item.StepDetails;

                <div class="doc-sheet text-dark">
                    <!-- Letterhead Header -->
                    <table class="doc-header-table">
                        <tr>
                            <td style="width: 58%;">
                                <div style="display: flex; align-items: center;">
                                    <img src="images/logo.png" alt="Company Logo" class="doc-logo-img" />
                                    <div>
                                        <h3 class="doc-company-title">@companyConfig.Name</h3>
                                        <p class="doc-company-info">
                                            @companyConfig.Address<br />
                                            โทร: @companyConfig.Phone | อีเมล: @companyConfig.Email<br />
                                            <span style="white-space: nowrap;">เลขประจำตัวผู้เสียภาษี: @companyConfig.TaxId</span>
                                        </p>
                                    </div>
                                </div>
                            </td>
                            <td style="width: 42%; text-align: right;">
                                <h2 class="doc-title-main">รายงานสรุปโครงการและส่งมอบงาน</h2>
                                <div class="doc-title-en">PROJECT COMPLETION & HANDOVER REPORT</div>
                                <table class="doc-ref-table">
                                    <tr>
                                        <td style="text-align: right; color: #475569;">เลขที่เอกสาร:</td>
                                        <td style="text-align: left; font-weight: 700; color: #0f2444;">REP-QT-@q.Id</td>
                                    </tr>
                                    <tr>
                                        <td style="text-align: right; color: #475569;">วันที่จัดทำเอกสาร:</td>
                                        <td style="text-align: left;">@DateTime.Today.ToString("dd/MM/yyyy")</td>
                                    </tr>
                                    <tr>
                                        <td style="text-align: right; color: #475569;">อ้างอิงใบเสนอราคา:</td>
                                        <td style="text-align: left; font-weight: 600;">QT-@q.Id</td>
                                    </tr>
                                    <tr>
                                        <td style="text-align: right; color: #475569;">สถานะโครงการ:</td>
                                        <td style="text-align: left; font-weight: 600; color: @(proj?.StepStatus == InstallationStep.Completed ? "#15803d" : "#0284c7");">
                                            @(proj != null ? GetStepName(proj.StepStatus) : GetQuotationStatusName(q.Status))
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <div class="doc-double-divider"></div>

                    <!-- ๑. ข้อมูลโครงการและผู้ว่าจ้าง -->
                    <div class="doc-section-heading">
                        <span>๑. ข้อมูลโครงการและผู้ว่าจ้าง (Project & Customer Information)</span>
                        <span style="font-size: 0.7rem; font-weight: normal; color: #475569;">สัญญาเลขที่: QT-@q.Id</span>
                    </div>
                    <table class="doc-grid-table">
                        <tbody>
                            <tr>
                                <td class="doc-cell-label">ลักษณะงาน / โครงการ</td>
                                <td class="doc-cell-value" colspan="3"><strong>@q.JobDescription</strong></td>
                            </tr>
                            <tr>
                                <td class="doc-cell-label">ผู้ว่าจ้าง (ลูกค้า)</td>
                                <td class="doc-cell-value" style="width: 31%;">@(q.Customer?.Name ?? "-")</td>
                                <td class="doc-cell-label" style="width: 18%;">เบอร์โทรศัพท์ / LINE</td>
                                <td class="doc-cell-value" style="width: 32%;">@(q.Customer?.Phone ?? "-") @(!string.IsNullOrEmpty(q.Customer?.LineId) ? $" (LINE: {q.Customer.LineId})" : "")</td>
                            </tr>
                            <tr>
                                <td class="doc-cell-label">สถานที่ติดตั้ง (หน้างาน)</td>
                                <td class="doc-cell-value" colspan="3">@(q.Customer?.Address ?? "-")</td>
                            </tr>
                            <tr>
                                <td class="doc-cell-label">พื้นที่ดำเนินการ</td>
                                <td class="doc-cell-value">@q.AreaSqm.ToString("N0") ตารางเมตร (ราคา ฿@q.PricePerUnit.ToString("N0") / ตร.ม.)</td>
                                <td class="doc-cell-label">ทีมช่างผู้รับผิดชอบ</td>
                                <td class="doc-cell-value">@(proj?.TechnicianTeam?.TeamName ?? "ช่างผู้ชำนาญการ") (หัวหน้าช่าง: @(proj?.TechnicianTeam?.LeaderName ?? "-"))</td>
                            </tr>
                            <tr>
                                <td class="doc-cell-label">วันที่ออกเอกสารสัญญา</td>
                                <td class="doc-cell-value">@q.CreatedDate.ToString("dd MMMM yyyy")</td>
                                <td class="doc-cell-label">ระยะเวลาดำเนินงาน</td>
                                <td class="doc-cell-value">@(proj != null ? proj.StartDate.ToString("dd/MM/yyyy") : "-") ถึง @(proj?.EndDate.HasValue == true ? proj.EndDate.Value.ToString("dd/MM/yyyy") : "ตามกำหนดการ")</td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- ๒. สรุปรายการบัญชีและการชำระเงิน -->
                    <div class="doc-section-heading">
                        <span>๒. สรุปรายการบัญชีและการชำระเงิน (Financial & Payment Statement)</span>
                        <span style="font-size: 0.7rem; font-weight: normal; color: #475569;">สถานะ: @GetPaymentStatusText(proj?.PaymentStatus ?? PaymentStatus.Pending)</span>
                    </div>
                    <table class="doc-grid-table">
                        <thead>
                            <tr>
                                <th style="width: 6%;">ลำดับ</th>
                                <th>รายการทางการเงิน</th>
                                <th style="width: 18%; text-align: right;">จำนวนเงิน (บาท)</th>
                                <th style="width: 30%;">สถานะการชำระ / วันที่บันทึก</th>
                                <th style="width: 18%;">หลักฐานการเงิน</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td style="text-align: center;">1</td>
                                <td>ค่าบริการติดตั้งพื้น Epoxy ทั้งหมดตามสัญญา</td>
                                <td style="text-align: right; font-weight: 600;">฿@q.TotalPrice.ToString("N0")</td>
                                <td>ตามใบเสนอราคา (@GetQuotationStatusName(q.Status))</td>
                                <td style="text-align: center; color: #475569;">สัญญา QT-@q.Id</td>
                            </tr>
                            <tr>
                                <td style="text-align: center;">2</td>
                                <td>หัก: เงินมัดจำงวดที่ 1 (ก่อนเริ่มดำเนินการ)</td>
                                <td style="text-align: right; color: #15803d; font-weight: 600;">- ฿@q.DepositAmount.ToString("N0")</td>
                                <td>
                                    ชำระแล้ว @(q.ApprovedDate.HasValue ? $"({q.ApprovedDate.Value:dd/MM/yyyy})" : "")
                                    @if (!string.IsNullOrEmpty(q.ApprovedBy))
                                    {
                                        <span style="font-size: 0.68rem; color: #64748b; display: block;">อนุมัติโดย: @q.ApprovedBy</span>
                                    }
                                </td>
                                <td style="text-align: center;">
                                    @if (!string.IsNullOrEmpty(q.PaymentSlipUrl))
                                    {
                                        <span style="color: #1d4ed8; font-weight: 600;">[ มีสลิปแนบท้าย ]</span>
                                    }
                                    else
                                    {
                                        <span style="color: #94a3b8;">ไม่มีเอกสารแนบ</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td style="text-align: center;">3</td>
                                <td>
                                    ยอดคงเหลือชำระงวดสุดท้าย (งวดส่งมอบงาน)
                                    @if (proj != null && proj.OverdueDays > 0 && proj.PaymentStatus == PaymentStatus.Pending)
                                    {
                                        <span style="color: #b91c1c; font-size: 0.68rem; display: block;">
                                            (เกินกำหนด @proj.OverdueDays วัน ค่าปรับ 3%/วัน: +฿@proj.LatePenaltyAmount.ToString("N0"))
                                        </span>
                                    }
                                </td>
                                <td style="text-align: right; font-weight: 700; color: @(proj?.PaymentStatus == PaymentStatus.Paid ? "#15803d" : "#b45309");">
                                    ฿@((proj != null && proj.OverdueDays > 0 && proj.PaymentStatus == PaymentStatus.Pending) ? proj.TotalPayableAmount.ToString("N0") : q.BalanceAmount.ToString("N0"))
                                </td>
                                <td>
                                    @if (proj?.PaymentStatus == PaymentStatus.Paid)
                                    {
                                        <span style="color: #15803d; font-weight: 600;">ชำระครบถ้วนแล้ว</span>
                                        @if (proj.PaymentDate.HasValue)
                                        {
                                            <span style="font-size: 0.68rem; color: #64748b; display: block;">วันที่: @proj.PaymentDate.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                        }
                                    }
                                    else
                                    {
                                        <span style="color: #b45309; font-weight: 600;">รอการชำระเงิน</span>
                                        @if (proj?.DueDate.HasValue == true)
                                        {
                                            <span style="font-size: 0.68rem; color: #64748b; display: block;">(กำหนดภายใน 7 วัน: @proj.DueDate.Value.ToString("dd/MM/yyyy"))</span>
                                        }
                                    }
                                </td>
                                <td style="text-align: center;">
                                    @if (proj != null && !string.IsNullOrEmpty(proj.FinalPaymentSlipUrl))
                                    {
                                        <span style="color: #1d4ed8; font-weight: 600;">[ มีสลิปแนบท้าย ]</span>
                                    }
                                    else
                                    {
                                        <span style="color: #94a3b8;">@(proj?.PaymentStatus == PaymentStatus.Paid ? "ไม่มีเอกสารแนบ" : "-")</span>
                                    }
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr style="background-color: #f8fafc; font-weight: bold;">
                                <td colspan="2" style="text-align: right;">สรุปยอดบัญชีสุทธิ:</td>
                                <td colspan="3" style="text-align: left; padding-left: 10px;">
                                    @if (proj?.PaymentStatus == PaymentStatus.Paid)
                                    {
                                        <span style="color: #15803d;">✔ ได้รับชำระเงินครบถ้วนสมบูรณ์แล้วทั้งสิ้น ฿@q.TotalPrice.ToString("N0")</span>
                                    }
                                    else
                                    {
                                        <span style="color: #b45309;">ยอดคงค้างรอชำระงวดสุดท้าย: ฿@((proj != null && proj.OverdueDays > 0) ? proj.TotalPayableAmount.ToString("N0") : q.BalanceAmount.ToString("N0"))</span>
                                    }
                                </td>
                            </tr>
                        </tfoot>
                    </table>

                    <!-- ๓. บันทึกผลการปฏิบัติงาน 4 ขั้นตอนและภาพถ่ายหน้างาน -->
                    <div class="doc-section-heading">
                        <span>๓. บันทึกผลการปฏิบัติงานจริงและหลักฐานภาพถ่าย (Work Execution & Inspection Records)</span>
